  "capabilities": [
    {
      "capability_id": "A1",
      "method_name": "move_end_effector_to_position",
      "description": "Move the UFACTORY xArm7 end effector to one bounded world-frame position.",
      "effect": "Bounded closed-loop end-effector position regulation.",
      "request_schema": {
        "type": "object",
        "properties": {
          "target_position_m": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "unit": "m",
            "frame": "world",
            "items": {
              "type": "number",
              "unit": "m",
              "frame": "world",
              "minimum": -1.0,
              "maximum": 1.0,
              "evidence_refs": [
                {
                  "source_id": "b1_driver_validation_criteria",
                  "specific_reference": "SO-101 A1 request bounds: target_position_m"
                }
              ]
            }
          },
          "max_duration_s": {
            "type": "number",
            "unit": "s",
            "frame": "none",
            "minimum": 0.25,
            "maximum": 8.0,
            "evidence_refs": [
              {
                "source_id": "b1_driver_validation_criteria",
                "specific_reference": "SO-101 A1 request bounds: max_duration_s"
              }
            ]
          }
        },
        "required": [
          "target_position_m",
          "max_duration_s"
        ],
        "additionalProperties": false
      },
      "preconditions": [
        "The public robot state is available and finite before motion starts.",
        "The requested world-frame target and duration satisfy the closed request schema."
      ],
      "temporal_semantics": {
        "kind": "bounded_closed_loop_regulation",
        "completion": "Regulate until the terminal hold criterion is satisfied or the requested duration expires."
      },
      "invariants": [
        "Commands remain within the public actuator and joint limits.",
        "The gripper aperture is not intentionally changed while the arm target is regulated."
      ],
      "failure_behavior": "Stop active motion and return a bounded capability error when the request cannot be completed within its declared duration or public limits.",
      "criteria": [
        {
          "metric": "end_effector_position_error",
          "unit": "m",
          "comparator": "<=",
          "threshold": 0.015,
          "temporal": {
            "kind": "continuous",
            "duration_s": 0.5
          },
          "aggregation": {
            "kind": "all_samples"
          },
          "source_refs": [
            {
              "source_id": "b1_driver_validation_criteria",
              "specific_reference": "SO-101 A1: position error <= 0.015 m continuously for 0.5 s"
            }
          ]
        }
      ],
      "evidence_refs": [
        {
          "source_id": "b1_driver_validation_criteria",
          "specific_reference": "SO-101 A1"
        }
      ]
    },
    {
      "capability_id": "A2",
