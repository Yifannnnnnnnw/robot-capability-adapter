      "description": "Trace bounded UFACTORY xArm7 world-frame Cartesian waypoints in order.",
      "effect": "Ordered Cartesian path tracking with bounded cross-track error.",
      "request_schema": {
        "type": "object",
        "properties": {
          "waypoints_m": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "unit": "m",
            "frame": "world",
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "unit": "m",
              "frame": "world",
              "items": {
                "type": "number",
                "unit": "m",
                "frame": "world",
                "minimum": -1.0,
                "maximum": 1.0,
                "evidence_refs": [
                  {
                    "source_id": "b1_driver_validation_criteria",
                    "specific_reference": "SO-101 A2 request bounds: waypoints_m"
                  }
                ]
              }
            }
          },
          "max_duration_per_segment_s": {
            "type": "number",
            "unit": "s",
            "frame": "none",
            "minimum": 0.25,
            "maximum": 5.0,
            "evidence_refs": [
              {
                "source_id": "b1_driver_validation_criteria",
                "specific_reference": "SO-101 A2 request bounds: max_duration_per_segment_s"
              }
            ]
          }
        },
        "required": [
          "waypoints_m",
          "max_duration_per_segment_s"
        ],
        "additionalProperties": false
      },
      "preconditions": [
        "The public robot state is available and finite before path execution starts.",
        "Every requested world-frame waypoint and segment duration satisfies the closed request schema."
      ],
      "temporal_semantics": {
        "kind": "ordered_bounded_segments",
        "completion": "Visit the supplied waypoints in order, then maintain the terminal waypoint for the criterion-defined hold."
      },
      "invariants": [
        "Waypoint order is preserved throughout the call.",
        "Commands remain within the public actuator and joint limits."
      ],
      "failure_behavior": "Stop active path motion and return a bounded capability error if a waypoint cannot be reached in sequence within the declared segment durations or public limits.",
      "criteria": [
        {
          "metric": "cartesian_path_error",
          "unit": "m",
          "comparator": "<=",
          "threshold": 0.02,
          "temporal": {
            "kind": "ordered_waypoints_and_terminal_hold",
            "terminal_hold_s": 0.5
          },
          "aggregation": {
            "kind": "maximum_cross_track_and_terminal_error"
          },
          "source_refs": [
            {
              "source_id": "b1_driver_validation_criteria",
              "specific_reference": "SO-101 A2: ordered waypoints, cross-track <= 0.020 m, final error <= 0.015 m for 0.5 s"
            }
          ],
          "checks": [
            {
              "metric": "cross_track_error",
              "unit": "m",
              "comparator": "<=",
              "threshold": 0.02
            },
            {
              "metric": "terminal_position_error",
              "unit": "m",
              "comparator": "<=",
              "threshold": 0.015
            }
          ]
        }
      ],
      "evidence_refs": [
        {
          "source_id": "b1_driver_validation_criteria",
          "specific_reference": "SO-101 A2"
        }
      ]
    },
