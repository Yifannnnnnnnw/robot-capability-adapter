            "unit": "m",
            "comparator": ">=",
            "threshold": 0.7,
            "temporal": {
              "kind": "eventual"
            },
            "aggregation": {
              "kind": "single_trial"
            }
          }
        },
        {
          "capability_id": "parkour_course",
          "method_name": "calibrate_parkour_course",
