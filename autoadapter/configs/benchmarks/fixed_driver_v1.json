          "semantic": "Drive a constrained rotary fixture to its requested target.",
          "primary_standard": {
            "source_task_id": "mw_faucet_open",
            "source_clause_id": "faucet_target_distance",
            "metric": "faucet_target_distance",
            "unit": "m",
            "comparator": "<=",
            "threshold": 0.07,
            "temporal": {
              "kind": "terminal_state_after_rotation"
            },
            "aggregation": {
              "kind": "single_trial"
            }
          },
