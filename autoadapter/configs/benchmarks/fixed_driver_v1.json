            "threshold": 4.983,
            "temporal": {
              "kind": "terminal_state"
            },
            "aggregation": {
              "kind": "per_trial_mean"
            }
          }
        },
        {
          "capability_id": "parkour_obstacles",
          "method_name": "calibrate_parkour_obstacles",
