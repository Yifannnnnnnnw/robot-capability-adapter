            "metric": "object_goal_distance",
            "unit": "m",
            "comparator": "<=",
            "threshold": 0.07,
            "temporal": {
              "kind": "terminal_state_after_release"
            },
            "aggregation": {
              "kind": "single_trial"
            }
          },
          "benchmark_gate": {
            "threshold": 0.03,
            "threshold_provenance": "pre_registered_human_approved_study_threshold"
          }
        },
        {
          "capability_id": "fixture",
          "method_name": "fixture_task",
          "semantic": "Operate a constrained translational or articulated fixture through contact.",
          "primary_standard": {
            "source_task_id": "mw_drawer_open",
            "source_clause_id": "open_handle_error",
            "metric": "drawer_handle_target_distance",
            "unit": "m",
            "comparator": "<=",
            "threshold": 0.03,
            "temporal": {
              "kind": "terminal_state_after_pull"
            },
            "aggregation": {
              "kind": "single_trial"
            }
          },
          "benchmark_gate": {
            "threshold": 0.015,
            "threshold_provenance": "pre_registered_human_approved_study_threshold"
          }
        },
        {
          "capability_id": "rotation",
