{
  "artifact_type": "fixed_driver_benchmark_contract",
  "schema_version": "1.0",
  "benchmark_id": "autoadapter2-fixed-driver-v1",
  "scope": {
    "kind": "fixed_interface_benchmark_slice",
    "replaces_formal_tgcd": false,
    "candidate_artifact": "driver.py",
    "factory_abi": "build(model, data)",
    "capability_abi": "method(request=request)",
    "reference_source_visibility": "framework_only",
    "source_standard_policy": "copy_exact_public_task_clause",
    "benchmark_gate_default": "primary_standard",
    "benchmark_gate_override": "copy_primary_standard_and_replace_threshold_from_benchmark_gate",
    "reference_measurements_define_thresholds": false
  },
  "acceptance": {
    "capability": "resolved_benchmark_gate_and_all_private_physical_integrity_guards",
    "robot": "all_selected_capabilities",
    "cohort": "all_eleven_robots",
    "formal_evidence": "verdict_plus_complete_framework_video",
    "source_standard_pass": "reported_separately",
    "candidate_self_report_is_evidence": false
  },
  "capability_profiles": {
    "metaworld_operations": {
      "capabilities": [
        {
          "capability_id": "reach",
          "method_name": "reach_task",
          "semantic": "Move the configured end effector to a requested Cartesian target.",
          "primary_standard": {
            "source_task_id": "mw_reach_target",
            "source_clause_id": "terminal_endpoint",
            "metric": "end_effector_target_distance",
            "unit": "m",
            "comparator": "<=",
            "threshold": 0.05,
            "temporal": {
              "kind": "terminal_state"
            },
            "aggregation": {
              "kind": "single_trial"
            }
          },
          "benchmark_gate": {
            "threshold": 0.02,
            "threshold_provenance": "pre_registered_human_approved_study_threshold"
          }
        },
        {
          "capability_id": "contact",
          "method_name": "contact_task",
          "semantic": "Move an ungrasped object to a goal through physical contact.",
          "primary_standard": {
            "source_task_id": "mw_push_to_goal",
            "source_clause_id": "object_goal_distance",
            "metric": "object_goal_distance",
            "unit": "m",
            "comparator": "<=",
            "threshold": 0.05,
            "temporal": {
              "kind": "terminal_state_after_push"
            },
            "aggregation": {
              "kind": "single_trial"
            }
          },
          "benchmark_gate": {
            "threshold": 0.02,
            "threshold_provenance": "pre_registered_human_approved_study_threshold"
          }
        },
        {
          "capability_id": "object",
          "method_name": "object_task",
          "semantic": "Grasp, transport, release, and place a free object.",
          "primary_standard": {
            "source_task_id": "mw_pick_place",
