          "duration_s": {"type": "number", "unit": "s", "frame": "none", "minimum": 2.0, "maximum": 4.0, "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "Go2 G1 request bounds: duration_s"}]}
