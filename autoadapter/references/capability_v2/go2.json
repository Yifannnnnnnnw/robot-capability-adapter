      "request_schema": {
        "type": "object",
        "properties": {
          "linear_velocity_body_m_s": {"type": "array", "minItems": 2, "maxItems": 2, "unit": "m/s", "frame": "body", "items": {"type": "number", "unit": "m/s", "frame": "body", "minimum": -0.4, "maximum": 0.4, "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "Go2 G1 request bounds: linear_velocity_body_m_s"}]}},
