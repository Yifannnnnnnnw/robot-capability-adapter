      "criteria": [{"metric": "wrist_roll_error", "unit": "rad", "comparator": "<=", "threshold": 0.03, "temporal": {"kind": "continuous", "duration_s": 0.25}, "aggregation": {"kind": "target_and_other_joint_hold"}, "source_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A6: wrist-roll error <= 0.03 rad and all other arm joints/gripper held"}], "checks": [{"metric": "other_joint_or_gripper_drift", "unit": "rad", "comparator": "<=", "threshold": 0.03}]}],
      "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A6"}]
    }
  ]
