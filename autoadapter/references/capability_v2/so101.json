  "capabilities": [
    {
      "capability_id": "A1",
      "method_name": "move_end_effector_to_position",
      "description": "Move the SO-101 end effector to one bounded world-frame position.",
      "effect": "Bounded closed-loop end-effector position regulation.",
      "request_schema": {
        "type": "object",
        "properties": {
          "target_position_m": {"type": "array", "minItems": 3, "maxItems": 3, "unit": "m", "frame": "world", "items": {"type": "number", "unit": "m", "frame": "world", "minimum": -1.0, "maximum": 1.0, "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A1 request bounds: target_position_m"}]}},
          "max_duration_s": {"type": "number", "unit": "s", "frame": "none", "minimum": 0.25, "maximum": 8.0, "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A1 request bounds: max_duration_s"}]}
        },
        "required": ["target_position_m", "max_duration_s"],
        "additionalProperties": false
      },
      "criteria": [{"metric": "end_effector_position_error", "unit": "m", "comparator": "<=", "threshold": 0.015, "temporal": {"kind": "continuous", "duration_s": 0.5}, "aggregation": {"kind": "all_samples"}, "source_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A1: position error <= 0.015 m continuously for 0.5 s"}]}],
      "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A1"}]
    },
    {
      "capability_id": "A2",
      "method_name": "trace_cartesian_path",
      "description": "Trace bounded SO-101 world-frame Cartesian waypoints in order.",
      "effect": "Ordered Cartesian path tracking with bounded cross-track error.",
      "request_schema": {
        "type": "object",
        "properties": {
          "waypoints_m": {"type": "array", "minItems": 2, "maxItems": 8, "unit": "m", "frame": "world", "items": {"type": "array", "minItems": 3, "maxItems": 3, "unit": "m", "frame": "world", "items": {"type": "number", "unit": "m", "frame": "world", "minimum": -1.0, "maximum": 1.0, "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A2 request bounds: waypoints_m"}]}}},
          "max_duration_per_segment_s": {"type": "number", "unit": "s", "frame": "none", "minimum": 0.25, "maximum": 5.0, "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A2 request bounds: max_duration_per_segment_s"}]}
        },
        "required": ["waypoints_m", "max_duration_per_segment_s"],
        "additionalProperties": false
      },
      "criteria": [{"metric": "cartesian_path_error", "unit": "m", "comparator": "<=", "threshold": 0.02, "temporal": {"kind": "ordered_waypoints_and_terminal_hold", "terminal_hold_s": 0.5}, "aggregation": {"kind": "maximum_cross_track_and_terminal_error"}, "source_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A2: ordered waypoints, cross-track <= 0.020 m, final error <= 0.015 m for 0.5 s"}], "checks": [{"metric": "cross_track_error", "unit": "m", "comparator": "<=", "threshold": 0.02}, {"metric": "terminal_position_error", "unit": "m", "comparator": "<=", "threshold": 0.015}]}],
      "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A2"}]
    },
    {
      "capability_id": "A3",
      "method_name": "set_gripper_opening",
      "description": "Set the SO-101 physical gripper aperture by normalised opening fraction.",
      "effect": "Bounded gripper aperture regulation without changing the arm target.",
      "request_schema": {
        "type": "object",
        "properties": {
          "opening_fraction": {"type": "number", "unit": "ratio", "frame": "none", "minimum": 0.0, "maximum": 1.0, "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A3 request bounds: opening_fraction"}]},
          "max_duration_s": {"type": "number", "unit": "s", "frame": "none", "minimum": 0.25, "maximum": 8.0, "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A3 request bounds: max_duration_s"}]}
        },
        "required": ["opening_fraction", "max_duration_s"],
        "additionalProperties": false
      },
      "criteria": [{"metric": "normalised_aperture_error", "unit": "ratio", "comparator": "<=", "threshold": 0.1, "temporal": {"kind": "continuous", "duration_s": 0.25}, "aggregation": {"kind": "all_samples_and_bidirectional_excursion"}, "source_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A3: aperture error <= 0.10 for 0.25 s and excursion >= 50%"}], "checks": [{"metric": "bidirectional_excursion", "unit": "ratio", "comparator": ">=", "threshold": 0.5}]}],
      "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A3"}]
    },
