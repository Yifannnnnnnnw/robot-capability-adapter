      "effect": "Bounded axial approach with controlled target contact and penetration.",
      "request_schema": {
        "type": "object",
        "properties": {
          "precontact_position_m": {"type": "array", "minItems": 3, "maxItems": 3, "unit": "m", "frame": "world", "items": {"type": "number", "unit": "m", "frame": "world", "minimum": -1.0, "maximum": 1.0, "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A4 request bounds: precontact_position_m"}]}},
          "approach_direction_unit": {"type": "array", "minItems": 3, "maxItems": 3, "unit": "unitless", "frame": "world", "items": {"type": "number", "unit": "unitless", "frame": "world", "minimum": -1.0, "maximum": 1.0, "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A4 request bounds: approach_direction_unit"}]}},
          "max_travel_m": {"type": "number", "unit": "m", "frame": "none", "exclusiveMinimum": 0.0, "maximum": 0.08, "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A4 request bounds: max_travel_m"}]},
          "max_approach_speed_m_s": {"type": "number", "unit": "m/s", "frame": "none", "exclusiveMinimum": 0.0, "maximum": 0.05, "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A4 request bounds: max_approach_speed_m_s"}]},
          "max_duration_s": {"type": "number", "unit": "s", "frame": "none", "minimum": 0.25, "maximum": 8.0, "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A4 request bounds: max_duration_s"}]}
        },
        "required": ["precontact_position_m", "approach_direction_unit", "max_travel_m", "max_approach_speed_m_s", "max_duration_s"],
        "additionalProperties": false
      },
      "criteria": [{"metric": "contact_integrity", "unit": "mixed", "comparator": "==", "threshold": 1, "temporal": {"kind": "ordered_precontact_ray_contact", "contact_hold_s": 0.1}, "aggregation": {"kind": "all_gates"}, "source_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A4: contact 0.1 s, post-contact speed <= 0.02 m/s, penetration <= 0.005 m, unrelated contacts 0"}], "checks": [{"metric": "post_contact_speed", "unit": "m/s", "comparator": "<=", "threshold": 0.02}, {"metric": "penetration", "unit": "m", "comparator": "<=", "threshold": 0.005}, {"metric": "unrelated_contact_count", "unit": "count", "comparator": "==", "threshold": 0}]}],
      "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A4"}]
    },
    {
      "capability_id": "A5",
      "method_name": "move_cartesian_offset_and_return",
