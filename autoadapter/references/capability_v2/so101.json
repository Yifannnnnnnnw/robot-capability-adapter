          "max_duration_per_leg_s": {"type": "number", "unit": "s", "frame": "none", "minimum": 0.25, "maximum": 5.0, "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A5 request bounds: max_duration_per_leg_s"}]}
        },
        "required": ["offset_robot_base_m", "max_duration_per_leg_s"],
        "additionalProperties": false
