      "criteria": [{"metric": "ordered_outbound_return_error", "unit": "m", "comparator": "<=", "threshold": 0.015, "temporal": {"kind": "ordered_phase_holds", "outbound_hold_s": 0.25, "return_hold_s": 0.5}, "aggregation": {"kind": "both_legs_and_displacement"}, "source_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A5: outbound/return errors <= 0.015 m and displacement >= 80%"}], "checks": [{"metric": "requested_displacement_fraction", "unit": "ratio", "comparator": ">=", "threshold": 0.8}]}],
      "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A5"}]
