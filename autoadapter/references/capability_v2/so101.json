          "max_duration_s": {"type": "number", "unit": "s", "frame": "none", "minimum": 0.25, "maximum": 8.0, "evidence_refs": [{"source_id": "b1_driver_validation_criteria", "specific_reference": "SO-101 A6 request bounds: max_duration_s"}]}
        },
