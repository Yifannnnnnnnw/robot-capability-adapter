{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot_capability.experience_record.v1",
  "title": "Robot Capability Experience Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experience_id",
    "version",
    "status",
    "scope",
    "origin",
    "failure_summary",
    "diagnosis",
    "recommended_change",
    "evidence",
    "outcome"
  ],
  "properties": {
    "schema_version": {"const": "robot_capability.experience_record.v1"},
    "experience_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["candidate", "approved", "rejected", "deprecated"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["robot_ids", "runtime_ids", "granularities", "capability_ids"],
      "properties": {
        "robot_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "runtime_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "granularities": {"type": "array", "items": {"enum": ["G1", "G2", "G3"]}, "uniqueItems": true},
        "capability_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_stage", "run_id", "case_or_task_ids", "observed_at"],
      "properties": {
        "source_stage": {"enum": ["static_validation", "direct_function_validation", "demo"]},
        "run_id": {"type": "string"},
        "case_or_task_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "failure_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "symptom", "preconditions"],
      "properties": {
        "category": {"type": "string"},
        "symptom": {"type": "string", "minLength": 1},
        "preconditions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis", "confidence", "alternatives_considered"],
      "properties": {
        "hypothesis": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "alternatives_considered": {"type": "array", "items": {"type": "string"}}
      }
    },
    "recommended_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_type", "guidance", "must_preserve"],
      "properties": {
        "change_type": {"enum": ["implementation", "interface", "capability_set", "prompt", "validation", "infrastructure"]},
        "guidance": {"type": "string", "minLength": 1},
        "must_preserve": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_refs", "before_measurements", "after_measurements"],
      "properties": {
        "artifact_refs": {"type": "array", "items": {"type": "string"}},
        "before_measurements": {"type": "object"},
        "after_measurements": {"type": "object"}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repair_attempted", "repair_succeeded", "regressions", "reuse_risk"],
      "properties": {
        "repair_attempted": {"type": "boolean"},
        "repair_succeeded": {"type": ["boolean", "null"]},
        "regressions": {"type": "array", "items": {"type": "string"}},
        "reuse_risk": {"enum": ["low", "medium", "high"]}
      }
    },
    "generation_summary": {
      "type": "object",
      "description": "Optional pre-sanitized view. If absent, the loader deterministically derives the allowlisted generation view.",
      "additionalProperties": false,
      "properties": {
        "applicability": {"type": "string"},
        "lesson": {"type": "string"},
        "recommended_pattern": {"type": "string"},
        "avoid_pattern": {"type": "string"}
      }
    }
  }
}
