{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot_capability.package_manifest.v2",
  "$defs": {
    "argumentName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "not": {"const": "runtime"}
    },
    "xyArgumentMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"$ref": "#/$defs/argumentName"},
        "y": {"$ref": "#/$defs/argumentName"},
        "z": {"$ref": "#/$defs/argumentName"}
      }
    },
    "xyzArgumentMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {"$ref": "#/$defs/argumentName"},
        "y": {"$ref": "#/$defs/argumentName"},
        "z": {"$ref": "#/$defs/argumentName"}
      }
    },
    "fieldName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "heightDeltaArgument": {
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9_]*_)?(?:lift_height|height_delta)_m$",
      "not": {"const": "runtime"}
    },
    "objectExtentSemantics": {
      "enum": ["cube_edge_m", "cylinder_diameter_m", "maximum_horizontal_extent_m"]
    },
    "contactHeightReference": {
      "enum": ["absolute_base_z_m", "height_above_table_m", "offset_from_object_center_m"]
    },
    "validationBinding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["effect", "joint_targets_argument"],
          "properties": {
            "effect": {"const": "joint_targets"},
            "joint_targets_argument": {"$ref": "#/$defs/argumentName"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["effect", "joint_target_arguments"],
          "properties": {
            "effect": {"const": "joint_targets"},
            "joint_target_arguments": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"$ref": "#/$defs/argumentName"},
              "propertyNames": {
                "enum": [
                  "shoulder_pan.pos",
                  "shoulder_lift.pos",
                  "elbow_flex.pos",
                  "wrist_flex.pos",
                  "wrist_roll.pos",
                  "gripper.pos"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["effect", "target_argument"],
          "properties": {
            "effect": {"const": "cartesian_target"},
            "target_argument": {"$ref": "#/$defs/argumentName"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["effect", "target_arguments"],
          "properties": {
            "effect": {"const": "cartesian_target"},
            "target_arguments": {"$ref": "#/$defs/xyzArgumentMap"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["effect", "source_argument", "target_argument", "target_components"],
          "dependentRequired": {
            "object_extent_argument": ["object_extent_semantics"],
            "object_extent_semantics": ["object_extent_argument"],
            "contact_height_argument": ["contact_height_reference"],
            "contact_height_reference": ["contact_height_argument"]
          },
          "properties": {
            "effect": {"const": "object_source_to_target"},
            "source_argument": {"$ref": "#/$defs/argumentName"},
            "target_argument": {"$ref": "#/$defs/argumentName"},
            "target_components": {"enum": ["xy", "xyz"]},
            "object_extent_argument": {"$ref": "#/$defs/argumentName"},
            "object_extent_semantics": {"$ref": "#/$defs/objectExtentSemantics"},
            "contact_height_argument": {"$ref": "#/$defs/argumentName"},
            "contact_height_reference": {"$ref": "#/$defs/contactHeightReference"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["effect", "source_arguments", "target_arguments", "target_components"],
          "dependentRequired": {
            "object_extent_argument": ["object_extent_semantics"],
            "object_extent_semantics": ["object_extent_argument"],
            "contact_height_argument": ["contact_height_reference"],
            "contact_height_reference": ["contact_height_argument"]
          },
          "properties": {
            "effect": {"const": "object_source_to_target"},
            "source_arguments": {"$ref": "#/$defs/xyzArgumentMap"},
            "target_arguments": {"$ref": "#/$defs/xyArgumentMap"},
            "target_components": {"enum": ["xy", "xyz"]},
            "object_extent_argument": {"$ref": "#/$defs/argumentName"},
            "object_extent_semantics": {"$ref": "#/$defs/objectExtentSemantics"},
            "contact_height_argument": {"$ref": "#/$defs/argumentName"},
            "contact_height_reference": {"$ref": "#/$defs/contactHeightReference"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["effect", "source_argument", "height_delta_argument"],
          "dependentRequired": {
            "object_extent_argument": ["object_extent_semantics"],
            "object_extent_semantics": ["object_extent_argument"]
          },
          "properties": {
            "effect": {"const": "object_source_plus_height_delta"},
            "source_argument": {"$ref": "#/$defs/argumentName"},
            "height_delta_argument": {"$ref": "#/$defs/heightDeltaArgument"},
            "object_extent_argument": {"$ref": "#/$defs/argumentName"},
            "object_extent_semantics": {"$ref": "#/$defs/objectExtentSemantics"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["effect", "source_arguments", "height_delta_argument"],
          "dependentRequired": {
            "object_extent_argument": ["object_extent_semantics"],
            "object_extent_semantics": ["object_extent_argument"]
          },
          "properties": {
            "effect": {"const": "object_source_plus_height_delta"},
            "source_arguments": {"$ref": "#/$defs/xyzArgumentMap"},
            "height_delta_argument": {"$ref": "#/$defs/heightDeltaArgument"},
            "object_extent_argument": {"$ref": "#/$defs/argumentName"},
            "object_extent_semantics": {"$ref": "#/$defs/objectExtentSemantics"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effect",
            "moves_argument",
            "source_field",
            "target_field",
            "object_extent_field",
            "object_extent_semantics",
            "target_components"
          ],
          "properties": {
            "effect": {"const": "object_move_sequence"},
            "moves_argument": {"$ref": "#/$defs/argumentName"},
            "source_field": {
              "$ref": "#/$defs/fieldName",
              "description": "Fixed literal key in every move item; never the name of a public field-selector parameter."
            },
            "target_field": {
              "$ref": "#/$defs/fieldName",
              "description": "Fixed literal key in every move item; never the name of a public field-selector parameter."
            },
            "object_extent_field": {
              "$ref": "#/$defs/fieldName",
              "description": "Fixed literal key containing the positive physical extent of that move's object."
            },
            "object_extent_semantics": {"const": "maximum_horizontal_extent_m"},
            "target_components": {"enum": ["xy", "xyz"]}
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage1_sha256", "package", "capabilities"],
  "properties": {
    "schema_version": {"const": "robot_capability.package_manifest.v2"},
    "stage1_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "package": {"const": "generated_capability_package"},
    "capabilities": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "granularity",
          "module",
          "function_name",
          "signature",
          "validation_binding",
          "result_contract"
        ],
        "properties": {
          "capability_id": {"type": "string"},
          "granularity": {"enum": ["G1", "G2", "G3"]},
          "module": {"enum": ["g1", "g2", "g3"]},
          "function_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "signature": {
            "type": "object",
            "additionalProperties": false,
            "required": ["parameters", "return_annotation"],
            "properties": {
              "parameters": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "annotation", "has_default"],
                  "properties": {
                    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                    "annotation": {"type": "string", "minLength": 1},
                    "has_default": {"type": "boolean"},
                    "default": {}
                  }
                }
              },
              "return_annotation": {"type": "string", "minLength": 1}
            }
          },
          "validation_binding": {"$ref": "#/$defs/validationBinding"},
          "result_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "required", "status_values", "success_status_values"],
            "properties": {
              "type": {"const": "object"},
              "required": {
                "type": "array",
                "contains": {"const": "status"},
                "items": {"type": "string"},
                "uniqueItems": true
              },
              "status_values": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string"},
                "uniqueItems": true
              },
              "success_status_values": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string"},
                "uniqueItems": true
              }
            }
          }
        }
      }
    }
  }
}
