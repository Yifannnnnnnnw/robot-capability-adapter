{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot_capability.demo_freeze.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "batch",
    "task_sources",
    "tasks",
    "catalog_sha256",
    "package_sha256",
    "consumer_prompt_sha256",
    "consumer_model",
    "agent_turn_budget_per_task",
    "oracle"
  ],
  "properties": {
    "schema_version": {"const": "robot_capability.demo_freeze.v2"},
    "run_id": {"type": "string", "minLength": 1},
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_sha256", "canonical_sha256", "task_order_seed"],
      "properties": {
        "file_sha256": {"$ref": "#/$defs/hash"},
        "canonical_sha256": {"$ref": "#/$defs/hash"},
        "task_order_seed": {"type": ["integer", "null"]}
      }
    },
    "task_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible_sha256", "pilot_heldout_sha256"],
      "properties": {
        "visible_sha256": {"$ref": "#/$defs/hash"},
        "pilot_heldout_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "partition",
          "task_id",
          "instance_ref",
          "task_sha256",
          "instance_sha256",
          "trace_path"
        ],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1, "maximum": 6},
          "partition": {"enum": ["visible", "pilot-held-out"]},
          "task_id": {"type": "string", "minLength": 1},
          "instance_ref": {"type": "string", "pattern": "^initial_states/[^/]+\\.json$"},
          "task_sha256": {"$ref": "#/$defs/hash"},
          "instance_sha256": {"$ref": "#/$defs/hash"},
          "trace_path": {"type": "string", "pattern": "^traces/[^/]+\\.jsonl$"}
        }
      }
    },
    "catalog_sha256": {"$ref": "#/$defs/hash"},
    "package_sha256": {"$ref": "#/$defs/hash"},
    "consumer_prompt_sha256": {"$ref": "#/$defs/hash"},
    "consumer_model": {"type": "object"},
    "agent_turn_budget_per_task": {"type": "integer", "minimum": 1, "maximum": 30},
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definitions_sha256",
        "contract_schema_sha256",
        "parser_source_sha256",
        "oracle_set_id",
        "contract_version",
        "evaluator_id",
        "evaluator_source_sha256"
      ],
      "properties": {
        "definitions_sha256": {"$ref": "#/$defs/hash"},
        "contract_schema_sha256": {"$ref": "#/$defs/hash"},
        "parser_source_sha256": {"$ref": "#/$defs/hash"},
        "oracle_set_id": {"type": "string", "minLength": 1},
        "contract_version": {"type": "string", "minLength": 1},
        "evaluator_id": {"type": "string", "minLength": 1},
        "evaluator_source_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
