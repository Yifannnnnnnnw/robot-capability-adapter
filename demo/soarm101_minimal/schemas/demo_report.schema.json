{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot_capability.demo_report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "catalog_sha256",
    "package_sha256",
    "demo_freeze_sha256",
    "tasks",
    "summary",
    "sealed_at"
  ],
  "properties": {
    "schema_version": {"const": "robot_capability.demo_report.v1"},
    "run_id": {"type": "string"},
    "catalog_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "demo_freeze_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tasks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "partition",
          "task_id",
          "agent_session_id",
          "agent_episode_id",
          "model_calls",
          "agent_turns",
          "provider_http_attempts",
          "provider_retries",
          "client_kind",
          "scripted",
          "agent_turn_budget",
          "provider_attempt_budget_policy",
          "usage",
          "agent_status",
          "termination_reason",
          "agent_final",
          "oracle",
          "passed",
          "trace_path"
        ],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1, "maximum": 6},
          "partition": {"enum": ["visible", "pilot-held-out"]},
          "task_id": {"type": "string", "minLength": 1},
          "agent_session_id": {"type": "string"},
          "agent_episode_id": {"type": "string"},
          "model_calls": {"type": "integer", "minimum": 0, "maximum": 30},
          "agent_turns": {"type": "integer", "minimum": 0, "maximum": 30},
          "provider_http_attempts": {"type": "integer", "minimum": 0},
          "provider_retries": {"type": "integer", "minimum": 0},
          "client_kind": {"type": "string", "minLength": 1},
          "scripted": {"type": "boolean"},
          "agent_turn_budget": {"type": "object"},
          "provider_attempt_budget_policy": {"type": "object"},
          "usage": {"type": "object"},
          "agent_status": {"type": "string", "minLength": 1},
          "termination_reason": {"type": "string", "minLength": 1},
          "agent_final": {"type": "string"},
          "oracle": {"type": "object"},
          "passed": {"type": "boolean"},
          "trace_path": {"type": "string", "pattern": "^traces/[^/]+\\.jsonl$"}
        }
      }
    },
    "summary": {"type": "object"},
    "sealed_at": {"type": "string", "format": "date-time"}
  }
}
