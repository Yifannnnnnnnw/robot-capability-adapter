{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot_capability.evolution_audit.v1",
  "title": "Read-only Evolution audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "architecture",
    "source_run_id",
    "ranked_findings",
    "selected_finding_id",
    "experience_claim",
    "privacy"
  ],
  "properties": {
    "schema_version": {"const": "robot_capability.evolution_audit.v1"},
    "architecture": {"const": "evidence_grounded_audit_synthesize_judge_publish"},
    "source_run_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "ranked_findings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "finding_id",
          "title",
          "category",
          "severity",
          "observation",
          "hypothesis",
          "confidence",
          "evidence_refs",
          "alternatives_considered"
        ],
        "properties": {
          "rank": {"type": "integer", "minimum": 1, "maximum": 8},
          "finding_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 120},
          "title": {"type": "string", "minLength": 1, "maxLength": 180},
          "category": {
            "enum": [
              "inputs", "prompt", "schema", "generation", "validation",
              "repair", "demo", "runtime", "budget", "evidence", "experience"
            ]
          },
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "observation": {"type": "string", "minLength": 1, "maxLength": 1200},
          "hypothesis": {"type": "string", "minLength": 1, "maxLength": 1200},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_refs": {
            "type": "array", "minItems": 1, "maxItems": 12,
            "items": {"type": "string", "minLength": 1, "maxLength": 260},
            "uniqueItems": true
          },
          "alternatives_considered": {
            "type": "array", "minItems": 1, "maxItems": 6,
            "items": {"type": "string", "minLength": 1, "maxLength": 600}
          }
        }
      }
    },
    "selected_finding_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "experience_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conclusion_kind",
        "scope",
        "symptom",
        "falsifiable_hypothesis",
        "confidence",
        "alternatives_considered",
        "recommended_change",
        "generation_summary",
        "future_test",
        "evidence_refs",
        "epistemic_status"
      ],
      "properties": {
        "conclusion_kind": {"enum": ["positive", "negative", "unresolved"]},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["robot_ids", "runtime_ids", "granularities", "capability_ids"],
          "properties": {
            "robot_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "soarm101"}, "uniqueItems": true},
            "runtime_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "lerobot_soarm101_0_6_0"}, "uniqueItems": true},
            "granularities": {"type": "array", "minItems": 1, "items": {"enum": ["G1", "G2", "G3"]}, "uniqueItems": true},
            "capability_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "symptom": {"type": "string", "minLength": 1, "maxLength": 1000},
        "falsifiable_hypothesis": {"type": "string", "minLength": 1, "maxLength": 1200},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "alternatives_considered": {
          "type": "array", "minItems": 1, "maxItems": 6,
          "items": {"type": "string", "minLength": 1, "maxLength": 600}
        },
        "recommended_change": {
          "type": "object",
          "additionalProperties": false,
          "required": ["change_type", "guidance", "must_preserve"],
          "properties": {
            "change_type": {"enum": ["implementation", "interface", "capability_set", "prompt", "validation", "infrastructure"]},
            "guidance": {"type": "string", "minLength": 1, "maxLength": 1200},
            "must_preserve": {
              "type": "array", "minItems": 1, "maxItems": 8,
              "items": {"type": "string", "minLength": 1, "maxLength": 300}
            }
          }
        },
        "generation_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicability", "lesson", "recommended_pattern", "avoid_pattern"],
          "properties": {
            "applicability": {"type": "string", "minLength": 1, "maxLength": 600},
            "lesson": {"type": "string", "minLength": 1, "maxLength": 800},
            "recommended_pattern": {"type": "string", "minLength": 1, "maxLength": 800},
            "avoid_pattern": {"type": "string", "minLength": 1, "maxLength": 800}
          }
        },
        "future_test": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "supporting_result", "falsifying_result"],
          "properties": {
            "action": {"type": "string", "minLength": 1, "maxLength": 800},
            "supporting_result": {"type": "string", "minLength": 1, "maxLength": 800},
            "falsifying_result": {"type": "string", "minLength": 1, "maxLength": 800}
          }
        },
        "evidence_refs": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {"type": "string", "minLength": 1, "maxLength": 260},
          "uniqueItems": true
        },
        "epistemic_status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_evidence_verified",
            "framework_change_applied",
            "capability_improvement_proven",
            "new_generation_validation_required"
          ],
          "properties": {
            "source_evidence_verified": {"const": true},
            "framework_change_applied": {"const": false},
            "capability_improvement_proven": {"const": false},
            "new_generation_validation_required": {"const": true}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "conclusion_kind": {"enum": ["positive", "negative"]}
            },
            "required": ["conclusion_kind"]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "contains": {"type": "string", "pattern": "^candidate:"}
              }
            }
          }
        }
      ]
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_keys_included",
        "raw_heldout_tasks_included",
        "private_oracles_included",
        "test_answers_included",
        "exact_hidden_measurements_included"
      ],
      "properties": {
        "api_keys_included": {"const": false},
        "raw_heldout_tasks_included": {"const": false},
        "private_oracles_included": {"const": false},
        "test_answers_included": {"const": false},
        "exact_hidden_measurements_included": {"const": false}
      }
    }
  }
}
