{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot_capability.evolution_candidate_bundle.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "contracts",
    "limits",
    "collection",
    "candidates",
    "promotion"
  ],
  "properties": {
    "schema_version": {"const": "robot_capability.evolution_candidate_bundle.v1"},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "mode",
        "terminal_state",
        "observed_at",
        "source_report",
        "source_report_verified",
        "source_report_issues"
      ],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"},
        "mode": {"enum": ["aws", "offline", "unknown"]},
        "terminal_state": {"type": "string", "pattern": "^[A-Z_]{2,64}$"},
        "observed_at": {"type": "string", "format": "date-time"},
        "source_report": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/evidenceRef"}
          ]
        },
        "source_report_verified": {"type": "boolean"},
        "source_report_issues": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 5,
          "items": {
            "enum": [
              "sealed_report_schema_invalid",
              "terminal_report_schema_invalid",
              "run_manifest_missing_or_invalid",
              "sealed_report_manifest_binding_invalid",
              "terminal_report_manifest_binding_invalid"
            ]
          }
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_schema",
        "experience_schema",
        "sealed_report_schema",
        "terminal_report_schema"
      ],
      "properties": {
        "bundle_schema": {"$ref": "#/$defs/contractRef"},
        "experience_schema": {"$ref": "#/$defs/contractRef"},
        "sealed_report_schema": {"$ref": "#/$defs/contractRef"},
        "terminal_report_schema": {"$ref": "#/$defs/contractRef"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_files_per_kind",
        "max_json_bytes",
        "max_failures_per_feedback",
        "max_candidates",
        "max_demo_tasks"
      ],
      "properties": {
        "max_files_per_kind": {"type": "integer", "minimum": 1, "maximum": 16},
        "max_json_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
        "max_failures_per_feedback": {"type": "integer", "minimum": 1, "maximum": 64},
        "max_candidates": {"type": "integer", "minimum": 1, "maximum": 12},
        "max_demo_tasks": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts",
        "discovered_by_kind",
        "included_by_kind",
        "omitted_by_limit",
        "invalid_or_oversized",
        "unbound",
        "candidate_omissions",
        "redaction"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "maxItems": 68,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "discovered_by_kind": {"$ref": "#/$defs/nonnegativeCounts"},
        "included_by_kind": {"$ref": "#/$defs/nonnegativeCounts"},
        "omitted_by_limit": {"$ref": "#/$defs/nonnegativeCounts"},
        "invalid_or_oversized": {"type": "integer", "minimum": 0, "maximum": 68},
        "unbound": {"type": "integer", "minimum": 0, "maximum": 68},
        "candidate_omissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["carried_no_change_feedback", "candidate_limit", "demo_reason"],
          "properties": {
            "carried_no_change_feedback": {"type": "integer", "minimum": 0},
            "candidate_limit": {"type": "integer", "minimum": 0},
            "demo_reason": {
              "type": ["string", "null"],
              "enum": [
                null,
                "infrastructure_demo_excluded",
                "invalid_demo_shape",
                "demo_task_limit_exceeded"
              ]
            }
          }
        },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_failure_messages",
            "tracebacks",
            "observed_target_gap_execution",
            "case_and_task_ids",
            "absolute_paths"
          ],
          "properties": {
            "raw_failure_messages": {"const": "excluded"},
            "tracebacks": {"const": "excluded"},
            "observed_target_gap_execution": {"const": "excluded"},
            "case_and_task_ids": {"const": "replaced_with_synthetic_refs"},
            "absolute_paths": {"const": "excluded"}
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 12,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automatic_library_writeback",
        "status",
        "target_records_path",
        "required_gates",
        "all_gates_satisfied"
      ],
      "properties": {
        "automatic_library_writeback": {"const": false},
        "status": {"const": "awaiting_explicit_approval"},
        "target_records_path": {"const": "libraries/experience/v1/records.jsonl"},
        "required_gates": {
          "type": "array",
          "prefixItems": [
            {"const": "schema"},
            {"const": "evidence"},
            {"const": "privacy"},
            {"const": "replay"},
            {"const": "human_approval"}
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        },
        "all_gates_satisfied": {"const": false}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^schemas/[a-z0-9_.-]+\\.json$"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "nonnegativeCounts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "bytes",
        "sha256",
        "status",
        "hash_bound",
        "semantic_valid"
      ],
      "properties": {
        "kind": {
          "enum": [
            "feedback",
            "repair_result",
            "static_report",
            "direct_report",
            "demo_report",
            "sealed_report",
            "terminal_report",
            "run_manifest"
          ]
        },
        "path": {"$ref": "#/$defs/relativePath"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/hash"}
          ]
        },
        "status": {
          "enum": [
            "parsed",
            "invalid_json",
            "invalid_shape",
            "invalid_schema",
            "semantic_invalid",
            "unbound",
            "oversized",
            "unsafe_or_missing"
          ]
        },
        "hash_bound": {"type": ["boolean", "null"]},
        "semantic_valid": {"type": ["boolean", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "semantic_invalid"}}},
          "then": {
            "properties": {
              "hash_bound": {"const": true},
              "semantic_valid": {"const": false}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "unbound"}}},
          "then": {"properties": {"hash_bound": {"const": false}}}
        }
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "satisfied", "reason"],
      "properties": {
        "required": {"const": true},
        "satisfied": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "candidatePromotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "eligible", "gates"],
      "properties": {
        "status": {"const": "awaiting_explicit_approval"},
        "eligible": {"const": false},
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "evidence", "privacy", "replay", "human_approval"],
          "properties": {
            "schema": {
              "allOf": [
                {"$ref": "#/$defs/gate"},
                {"properties": {"satisfied": {"const": true}}}
              ]
            },
            "evidence": {"$ref": "#/$defs/gate"},
            "privacy": {
              "allOf": [
                {"$ref": "#/$defs/gate"},
                {"properties": {"satisfied": {"const": false}}}
              ]
            },
            "replay": {
              "allOf": [
                {"$ref": "#/$defs/gate"},
                {"properties": {"satisfied": {"const": false}}}
              ]
            },
            "human_approval": {
              "allOf": [
                {"$ref": "#/$defs/gate"},
                {"properties": {"satisfied": {"const": false}}}
              ]
            }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "raw_messages_copied",
        "tracebacks_copied",
        "case_or_task_ids_copied",
        "exact_measurements_copied"
      ],
      "properties": {
        "classification": {"const": "private_run_local"},
        "raw_messages_copied": {"const": false},
        "tracebacks_copied": {"const": false},
        "case_or_task_ids_copied": {"const": false},
        "exact_measurements_copied": {"const": false}
      }
    },
    "evidenceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_count",
        "failure_codes",
        "feedback",
        "repair_result",
        "after_reports",
        "package_changed",
        "after_stage_passed",
        "package_identity_bound",
        "sealed_demo_passed",
        "source_report_verified",
        "causal_outcome"
      ],
      "properties": {
        "failure_count": {"type": "integer", "minimum": 1},
        "failure_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}
        },
        "feedback": {"$ref": "#/$defs/evidenceRef"},
        "repair_result": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/evidenceRef"}
          ]
        },
        "after_reports": {
          "type": "array",
          "maxItems": 2,
          "items": {"$ref": "#/$defs/evidenceRef"}
        },
        "package_changed": {"type": ["boolean", "null"]},
        "after_stage_passed": {"type": ["boolean", "null"]},
        "package_identity_bound": {"type": "boolean"},
        "sealed_demo_passed": {"type": "boolean"},
        "source_report_verified": {"type": "boolean"},
        "causal_outcome": {"enum": ["confirmed_success", "confirmed_failure", "unresolved"]}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_payload_sha256",
        "claim_kind",
        "dedupe_key",
        "source_stage",
        "source_round",
        "proposed_record",
        "evidence_summary",
        "privacy",
        "promotion"
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "candidate_payload_sha256": {"$ref": "#/$defs/hash"},
        "claim_kind": {
          "enum": ["successful_repair", "failed_repair", "unresolved_failure", "demo_failure"]
        },
        "dedupe_key": {"$ref": "#/$defs/hash"},
        "source_stage": {
          "enum": ["static_validation", "direct_function_validation", "demo"]
        },
        "source_round": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 0, "maximum": 99}
          ]
        },
        "proposed_record": {
          "type": "object",
          "required": ["schema_version", "status"],
          "properties": {
            "schema_version": {"const": "robot_capability.experience_record.v1"},
            "status": {"const": "candidate"}
          },
          "description": "Also validated at runtime against schemas/experience.schema.json."
        },
        "evidence_summary": {"$ref": "#/$defs/evidenceSummary"},
        "privacy": {"$ref": "#/$defs/privacy"},
        "promotion": {"$ref": "#/$defs/candidatePromotion"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"claim_kind": {"const": "successful_repair"}},
            "required": ["claim_kind"]
          },
          "then": {
            "properties": {
              "evidence_summary": {
                "properties": {
                  "package_changed": {"const": true},
                  "after_stage_passed": {"const": true},
                  "package_identity_bound": {"const": true},
                  "sealed_demo_passed": {"const": true},
                  "source_report_verified": {"const": true},
                  "causal_outcome": {"const": "confirmed_success"}
                }
              },
              "proposed_record": {
                "properties": {
                  "outcome": {
                    "type": "object",
                    "required": ["repair_succeeded"],
                    "properties": {"repair_succeeded": {"const": true}}
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"claim_kind": {"const": "failed_repair"}},
            "required": ["claim_kind"]
          },
          "then": {
            "properties": {
              "evidence_summary": {
                "properties": {
                  "source_report_verified": {"const": true},
                  "causal_outcome": {"const": "confirmed_failure"}
                }
              },
              "proposed_record": {
                "properties": {
                  "outcome": {
                    "type": "object",
                    "required": ["repair_succeeded"],
                    "properties": {"repair_succeeded": {"const": false}}
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_kind": {
                "enum": ["unresolved_failure", "demo_failure"]
              }
            },
            "required": ["claim_kind"]
          },
          "then": {
            "properties": {
              "evidence_summary": {
                "properties": {"causal_outcome": {"const": "unresolved"}}
              },
              "promotion": {
                "properties": {
                  "gates": {
                    "properties": {
                      "evidence": {
                        "properties": {"satisfied": {"const": false}}
                      }
                    }
                  }
                }
              },
              "proposed_record": {
                "properties": {
                  "outcome": {
                    "type": "object",
                    "required": ["repair_succeeded"],
                    "properties": {"repair_succeeded": {"type": "null"}}
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
