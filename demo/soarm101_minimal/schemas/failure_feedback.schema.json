{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot_capability.failure_feedback.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "repair_round", "failures"],
  "properties": {
    "schema_version": {"const": "robot_capability.failure_feedback.v1"},
    "stage": {"enum": ["static", "direct_function"]},
    "repair_round": {"type": "integer", "minimum": 0, "maximum": 10},
    "no_package_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "completed_repair_round",
        "consecutive_rounds",
        "causal_feedback_repair_round",
        "package_sha256",
        "retry_available"
      ],
      "properties": {
        "code": {"const": "NO_PACKAGE_CHANGE"},
        "completed_repair_round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "consecutive_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "causal_feedback_repair_round": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "package_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "retry_available": {"type": "boolean"}
      }
    },
    "failures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"},
          "capability_id": {"type": ["string", "null"]},
          "case_id": {"type": ["string", "null"]},
          "observed": {},
          "target": {},
          "gap": {},
          "execution": {"type": "object"},
          "diagnostics": {},
          "traceback": {"type": ["string", "null"]}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"required": ["no_package_change"]},
      "then": {
        "properties": {
          "failures": {
            "items": {
              "required": ["code", "message", "observed", "target"],
              "not": {
                "required": ["code"],
                "properties": {"code": {"const": "NO_PACKAGE_CHANGE"}}
              }
            }
          }
        }
      }
    }
  ]
}
