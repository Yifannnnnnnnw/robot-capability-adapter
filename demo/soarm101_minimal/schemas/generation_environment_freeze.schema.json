{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot_capability.generation_environment_freeze.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest", "manifest_sha256"],
  "properties": {
    "schema_version": {
      "const": "robot_capability.generation_environment_freeze.v1"
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "resolver_version",
        "selection",
        "bindings",
        "public_task_selection",
        "public_simulation",
        "asset_resolution"
      ],
      "properties": {
        "schema_version": {
          "const": "robot_capability.generation_environment_manifest.v1"
        },
        "resolver_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "selection": {"$ref": "#/$defs/selection"},
        "bindings": {"$ref": "#/$defs/bindings"},
        "public_task_selection": {"$ref": "#/$defs/public_task_selection"},
        "public_simulation": {"$ref": "#/$defs/public_simulation"},
        "asset_resolution": {"$ref": "#/$defs/asset_resolution"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "version": {"type": "string", "minLength": 1},
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "entry_id": {"$ref": "#/$defs/identifier"},
        "robot_id": {"$ref": "#/$defs/identifier"},
        "scene_id": {"$ref": "#/$defs/identifier"},
        "catalog_id": {"$ref": "#/$defs/identifier"},
        "runtime_id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/version"},
        "asset_descriptor_sha256": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^morphology\\.scene_asset/[a-z][a-z0-9_]*@[0-9]+\\.[0-9]+\\.[0-9]+#[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "robot_referenced_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "path", "sha256"],
      "properties": {
        "kind": {
          "enum": ["mesh", "texture", "hfield", "skin"]
        },
        "reference": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "robot_model_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "robot_id",
        "version",
        "model_format",
        "referenced_files"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "robot_id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/version"},
        "model_format": {"const": "mujoco_mjcf"},
        "referenced_files": {
          "type": "array",
          "items": {"$ref": "#/$defs/robot_referenced_file"}
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top_level_library_types",
        "morphology",
        "sdk_runtime",
        "tasks",
        "experience"
      ],
      "properties": {
        "top_level_library_types": {
          "type": "array",
          "prefixItems": [
            {"const": "experience"},
            {"const": "morphology"},
            {"const": "sdk_runtime"},
            {"const": "tasks"}
          ],
          "items": false
        },
        "morphology": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "robot_entry_id",
            "robot_entry_version",
            "scene_entry_id",
            "scene_entry_version",
            "scene_id"
          ],
          "properties": {
            "robot_entry_id": {"$ref": "#/$defs/identifier"},
            "robot_entry_version": {"$ref": "#/$defs/version"},
            "scene_entry_id": {"$ref": "#/$defs/identifier"},
            "scene_entry_version": {"$ref": "#/$defs/version"},
            "scene_id": {"$ref": "#/$defs/identifier"}
          }
        },
        "sdk_runtime": {"$ref": "#/$defs/entry_selection_with_runtime"},
        "tasks": {"$ref": "#/$defs/entry_selection"},
        "experience": {"$ref": "#/$defs/entry_selection"}
      }
    },
    "entry_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "version"],
      "properties": {
        "entry_id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/version"}
      }
    },
    "entry_selection_with_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "version", "runtime_id"],
      "properties": {
        "entry_id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/version"},
        "runtime_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["morphology", "sdk_runtime", "tasks", "experience"],
      "properties": {
        "morphology": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "robot_manifest",
            "robot_model",
            "attachments",
            "scene_manifest",
            "scene_definition",
            "scene_asset_catalog"
          ],
          "properties": {
            "robot_manifest": {"$ref": "#/$defs/source_binding"},
            "robot_model": {"$ref": "#/$defs/robot_model_binding"},
            "attachments": {"$ref": "#/$defs/source_binding"},
            "scene_manifest": {"$ref": "#/$defs/source_binding"},
            "scene_definition": {"$ref": "#/$defs/source_binding"},
            "scene_asset_catalog": {"$ref": "#/$defs/source_binding"}
          }
        },
        "sdk_runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest", "runtime_contract"],
          "properties": {
            "manifest": {"$ref": "#/$defs/source_binding"},
            "runtime_contract": {"$ref": "#/$defs/source_binding"}
          }
        },
        "tasks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest", "environment_requirements", "visible_tasks"],
          "properties": {
            "manifest": {"$ref": "#/$defs/source_binding"},
            "environment_requirements": {"$ref": "#/$defs/source_binding"},
            "visible_tasks": {"$ref": "#/$defs/source_binding"}
          }
        },
        "experience": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest", "records"],
          "properties": {
            "manifest": {"$ref": "#/$defs/source_binding"},
            "records": {"$ref": "#/$defs/source_binding"}
          }
        }
      }
    },
    "public_task_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection",
        "task_count",
        "task_ids",
        "requirements_sha256",
        "concrete_instances_included",
        "validation_oracles_included"
      ],
      "properties": {
        "projection": {"const": "generation_visible_templates_only"},
        "task_count": {"type": "integer", "minimum": 1},
        "task_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "requirements_sha256": {"$ref": "#/$defs/sha256"},
        "concrete_instances_included": {"const": false},
        "validation_oracles_included": {"const": false}
      }
    },
    "public_simulation": {
      "type": "object",
      "required": [
        "privacy_class",
        "not_task_instance",
        "common_reset",
        "smoke_instance",
        "probe_inputs"
      ],
      "properties": {
        "privacy_class": {"const": "public_generation_sandbox"},
        "not_task_instance": {"const": true},
        "common_reset": {"type": "object"},
        "smoke_instance": {"type": "object"},
        "probe_inputs": {"type": "object"}
      }
    },
    "asset_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "materialization",
        "unreferenced_assets_materialized",
        "missing_asset_result"
      ],
      "properties": {
        "source": {"const": "morphology_scene_catalog"},
        "materialization": {"const": "on_demand"},
        "unreferenced_assets_materialized": {"const": false},
        "missing_asset_result": {"const": "MISSING_ASSET"}
      }
    }
  }
}
