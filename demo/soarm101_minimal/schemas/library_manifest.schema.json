{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot_capability.library_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "library_type", "entry_id", "version", "status", "generation_visibility", "payloads", "content_hashes", "provenance"],
  "properties": {
    "schema_version": {"const": "robot_capability.library_manifest.v1"},
    "entry_kind": {"enum": ["robot", "scene"]},
    "library_type": {"enum": ["morphology", "sdk_runtime", "tasks", "experience"]},
    "entry_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "ready", "deprecated"]},
    "generation_visibility": {"enum": ["visible", "private", "mixed"]},
    "payloads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "visibility"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "visibility": {"enum": ["generation", "framework", "private"]},
          "media_type": {"type": "string"},
          "required": {"type": "boolean"}
        }
      }
    },
    "content_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "compatibility": {"type": "object"},
    "provenance": {"type": "object"}
  }
}
