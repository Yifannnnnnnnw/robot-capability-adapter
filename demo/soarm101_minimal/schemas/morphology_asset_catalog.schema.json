{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot_capability.morphology_scene_asset_catalog.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "version", "ownership", "reference_format", "assets"],
  "properties": {
    "schema_version": {"const": "robot_capability.morphology_scene_asset_catalog.v1"},
    "catalog_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "ownership": {"const": "morphology_scene_registry"},
    "reference_format": {"const": "morphology.scene_asset/{asset_id}@{version}#{variant_id}"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "role", "runtime_kind", "builder", "physics", "instance_contract", "geometry_profile", "variants"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "role": {"enum": ["support_surface", "dynamic_object", "receptacle", "marker"]},
          "runtime_kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "builder": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]+$"},
          "physics": {
            "type": "object",
            "additionalProperties": false,
            "required": ["collision_enabled", "friction", "condim"],
            "properties": {
              "collision_enabled": {"type": "boolean"},
              "friction": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number", "minimum": 0}, {"type": "number", "minimum": 0}], "items": false},
              "condim": {"enum": [1, 3, 4, 6]}
            }
          },
          "instance_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required_fields", "optional_fields", "asset_ref_required", "inline_physical_overrides_allowed"],
            "properties": {
              "required_fields": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "uniqueItems": true},
              "optional_fields": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "uniqueItems": true},
              "asset_ref_required": {"const": true},
              "inline_physical_overrides_allowed": {"const": false}
            }
          },
          "geometry_profile": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "center_m": {"$ref": "#/$defs/vec3"},
              "half_size_m": {"$ref": "#/$defs/positive_vec3"},
              "surface_z_m": {"type": "number"},
              "size_m": {"$ref": "#/$defs/positive_vec3"},
              "mass_kg": {"type": "number", "exclusiveMinimum": 0},
              "radius_m": {"type": "number", "exclusiveMinimum": 0},
              "height_m": {"type": "number", "exclusiveMinimum": 0},
              "inner_size_m": {"$ref": "#/$defs/positive_vec2"},
              "rim_height_m": {"type": "number", "exclusiveMinimum": 0},
              "inner_radius_m": {"type": "number", "exclusiveMinimum": 0},
              "wall_thickness_m": {"type": "number", "exclusiveMinimum": 0},
              "floor_thickness_m": {"type": "number", "exclusiveMinimum": 0},
              "radial_segments": {"type": "integer", "minimum": 8, "maximum": 64},
              "marker_height_m": {"type": "number", "exclusiveMinimum": 0},
              "marker_radius_m": {"type": "number", "exclusiveMinimum": 0}
            }
          },
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["variant_id", "label", "material_rgba"],
              "properties": {
                "variant_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                "label": {"type": "string", "minLength": 1},
                "material_rgba": {"$ref": "#/$defs/rgba"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "vec3": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false},
    "positive_vec3": {"type": "array", "prefixItems": [{"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}], "items": false},
    "positive_vec2": {"type": "array", "prefixItems": [{"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}], "items": false},
    "rgba": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}], "items": false}
  }
}
