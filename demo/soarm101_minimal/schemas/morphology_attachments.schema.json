{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot_capability.morphology_attachments.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "robot_id", "version", "attachments"],
  "properties": {
    "schema_version": {"const": "robot_capability.morphology_attachments.v1"},
    "robot_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "version": {"type": "string", "minLength": 1},
    "attachments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attachment_id", "kind", "integration", "status", "required_runtime_id", "model_binding", "capabilities"],
        "properties": {
          "attachment_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "kind": {"enum": ["end_effector", "camera", "camera_mount", "tool"]},
          "integration": {"enum": ["integrated_in_robot_model", "optional_payload"]},
          "status": {"enum": ["active", "available", "unavailable"]},
          "required_runtime_id": {"type": "string", "minLength": 1},
          "model_binding": {
            "type": "object",
            "additionalProperties": false,
            "required": ["robot_model_path", "robot_model_sha256", "geometry_payloads"],
            "properties": {
              "robot_model_path": {"type": "string", "pattern": "^[^/].*"},
              "robot_model_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "geometry_payloads": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "sha256"],
                  "properties": {
                    "path": {"type": "string", "pattern": "^[^/].*"},
                    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
                  }
                }
              }
            }
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provides", "selection_policy"],
            "properties": {
              "provides": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "selection_policy": {"enum": ["always_with_robot", "task_requirement_only"]}
            }
          }
        }
      }
    }
  }
}
