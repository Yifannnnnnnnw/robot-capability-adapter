{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot_capability.private_execution_bundle_freeze.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest", "manifest_sha256"],
  "properties": {
    "schema_version": {
      "const": "robot_capability.private_execution_bundle_freeze.v1"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "hash_algorithm",
        "private_partition_source_sha256",
        "privacy",
        "partition_counts",
        "files"
      ],
      "properties": {
        "schema_version": {
          "const": "robot_capability.private_execution_bundle_manifest.v1"
        },
        "hash_algorithm": {"const": "sha256_raw_bytes"},
        "private_partition_source_sha256": {"$ref": "#/$defs/hash"},
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generation_visible",
            "agent_snapshot_member",
            "log_payloads_allowed"
          ],
          "properties": {
            "generation_visible": {"const": false},
            "agent_snapshot_member": {"const": false},
            "log_payloads_allowed": {"const": false}
          }
        },
        "partition_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generation_visible_templates",
            "pilot_heldout_templates",
            "authored_instances",
            "selected_visible_instances",
            "selected_pilot_heldout_instances",
            "selected_instances"
          ],
          "properties": {
            "generation_visible_templates": {"const": 9},
            "pilot_heldout_templates": {"const": 3},
            "authored_instances": {"const": 12},
            "selected_visible_instances": {"const": 3},
            "selected_pilot_heldout_instances": {"const": 3},
            "selected_instances": {"const": 6}
          }
        },
        "files": {
          "type": "array",
          "minItems": 23,
          "maxItems": 23,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "path", "bytes", "sha256"],
            "properties": {
              "role": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "path": {
                "type": "string",
                "pattern": "^data/(demo_batch\\.json|visible_tasks\\.jsonl|heldout_tasks\\.jsonl|task_oracles\\.yaml|initial_states/(_common_reset|instance_[0-9]{2}|authored_instance_[0-9]{2})\\.json)$"
              },
              "bytes": {"type": "integer", "minimum": 1},
              "sha256": {"$ref": "#/$defs/hash"}
            }
          }
        }
      }
    },
    "manifest_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
