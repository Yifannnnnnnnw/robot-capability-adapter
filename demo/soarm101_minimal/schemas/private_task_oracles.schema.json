{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot_capability.private_task_oracles.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "oracle_set_id",
    "version",
    "visibility",
    "status",
    "scene_feasibility_gate",
    "measurement_convention",
    "common_forbidden_conditions",
    "predicates",
    "freeze_gate"
  ],
  "properties": {
    "schema_version": {"const": "robot_capability.private_task_oracles.v1"},
    "oracle_set_id": {"const": "soarm101_tabletop_p0"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "visibility": {"const": "harness_only"},
    "status": {"const": "p0_frozen"},
    "scene_feasibility_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_role",
        "evidence_schema",
        "authored_task_scope",
        "native_policy",
        "offline_policy"
      ],
      "properties": {
        "evidence_role": {"const": "framework/private_execution_preflight.json"},
        "evidence_schema": {"const": "robot_capability.private_execution_preflight.v2"},
        "authored_task_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation_visible", "pilot_heldout", "total"],
          "properties": {
            "generation_visible": {"const": 9},
            "pilot_heldout": {"const": 3},
            "total": {"const": 12}
          }
        },
        "native_policy": {"const": "fresh_task_world_compile_reset_and_finite_state_required_at_execution"},
        "offline_policy": {"const": "catalog_and_task_contract_checks_only_no_native_claim"}
      }
    },
    "measurement_convention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_frame",
        "position_unit",
        "velocity_unit",
        "angle_unit",
        "evaluation_time",
        "note"
      ],
      "properties": {
        "coordinate_frame": {"const": "robot_base"},
        "position_unit": {"const": "m"},
        "velocity_unit": {"const": "m/s"},
        "angle_unit": {"const": "rad"},
        "evaluation_time": {"const": "after_task_termination_request_and_settle_window"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "common_forbidden_conditions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/forbidden"}
    },
    "predicates": {
      "type": "object",
      "minProperties": 12,
      "maxProperties": 12,
      "propertyNames": {"pattern": "^oracle\\.[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/predicate"}
    },
    "freeze_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scope",
        "reachability",
        "contract_binding",
        "required_evidence"
      ],
      "properties": {
        "status": {"const": "passed"},
        "scope": {"const": "p0_scoring_threshold_contract"},
        "reachability": {"const": "not_predeclared_or_scored"},
        "contract_binding": {"const": "raw_bytes_sha256_in_private_execution_bundle"},
        "required_evidence": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "schema_and_semantic_validation",
              "exact_pass_fail_boundary_unit_probes",
              "per_executed_case_fresh_world_compile_reset_and_finite_state"
            ]
          },
          "allOf": [
            {"contains": {"const": "schema_and_semantic_validation"}},
            {"contains": {"const": "exact_pass_fail_boundary_unit_probes"}},
            {"contains": {"const": "per_executed_case_fresh_world_compile_reset_and_finite_state"}}
          ]
        }
      }
    }
  },
  "$defs": {
    "finiteNonnegative": {"type": "number", "minimum": 0},
    "finitePositive": {"type": "number", "exclusiveMinimum": 0},
    "forbidden": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "disposition"],
      "properties": {
        "condition": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "parameters": {"type": "object"},
        "disposition": {"enum": ["fail", "do_not_score_as_capability_failure"]}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measure", "operator"],
      "properties": {
        "measure": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "operator": {
          "enum": [
            "less_than_or_equal",
            "less_than_or_equal_over_window",
            "is_true",
            "is_true_for_window",
            "is_false",
            "equals"
          ]
        },
        "object_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "object_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "support_object_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "receptacle_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "target_ref": {"type": "string", "pattern": "^agent_input\\.[a-z0-9_.]+$"},
        "expected_object_ids_ref": {"type": "string", "pattern": "^agent_input\\.[a-z0-9_.]+$"},
        "expected_mapping_ref": {"type": "string", "pattern": "^agent_input\\.[a-z0-9_.]+$"},
        "target_axis": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number"}
        },
        "tolerance": {"$ref": "#/$defs/finitePositive"},
        "parameters": {"type": "object"}
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "timeout_s", "all_of"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^soarm101_p0_[a-z][a-z0-9_]*$"},
        "timeout_s": {"$ref": "#/$defs/finitePositive"},
        "settle_window_s": {"$ref": "#/$defs/finiteNonnegative"},
        "hold_window_s": {"$ref": "#/$defs/finitePositive"},
        "all_of": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/condition"}
        }
      },
      "oneOf": [
        {"required": ["settle_window_s"], "not": {"required": ["hold_window_s"]}},
        {"required": ["hold_window_s"], "not": {"required": ["settle_window_s"]}}
      ]
    }
  }
}
