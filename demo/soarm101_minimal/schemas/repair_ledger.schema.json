{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot_capability.repair_ledger.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "continuity",
    "through_repair_round",
    "round_count",
    "failure_registry",
    "rounds",
    "unresolved_prior_failures",
    "privacy_contract",
    "max_utf8_bytes",
    "utf8_bytes"
  ],
  "properties": {
    "schema_version": {"const": "robot_capability.repair_ledger.v2"},
    "continuity": {"$ref": "#/$defs/continuity"},
    "through_repair_round": {"type": "integer", "minimum": 0, "maximum": 10},
    "round_count": {"type": "integer", "minimum": 0, "maximum": 10},
    "failure_registry": {
      "type": "object",
      "maxProperties": 640,
      "propertyNames": {"pattern": "^f(?:[1-9][0-9]{0,2})$"},
      "additionalProperties": {"$ref": "#/$defs/failureSignature"}
    },
    "rounds": {
      "type": "array",
      "maxItems": 10,
      "items": {"$ref": "#/$defs/round"}
    },
    "unresolved_prior_failures": {
      "type": "array",
      "maxItems": 640,
      "items": {"$ref": "#/$defs/unresolvedFailure"}
    },
    "privacy_contract": {"$ref": "#/$defs/privacyContract"},
    "max_utf8_bytes": {"type": "integer", "minimum": 1},
    "utf8_bytes": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "safeIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:/-]{1,160}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "session_id", "episode_id", "same_agent_session"],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "episode_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "same_agent_session": {"const": true}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "unresolved_symbol"],
      "properties": {
        "kind": {"const": "python_unresolved_symbol"},
        "unresolved_symbol": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,79}$"
        }
      }
    },
    "failureSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "capability_ref", "case_ref", "signature_sha256"],
      "properties": {
        "code": {"$ref": "#/$defs/safeIdentifier"},
        "capability_ref": {
          "oneOf": [
            {"type": "string", "pattern": "^cap_[a-f0-9]{24}$"},
            {"type": "null"}
          ]
        },
        "case_ref": {
          "oneOf": [
            {"type": "string", "pattern": "^case_[a-f0-9]{24}$"},
            {"type": "null"}
          ]
        },
        "diagnostic": {"$ref": "#/$defs/diagnostic"},
        "signature_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "failureRefs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^f(?:[1-9][0-9]{0,2})$"
      }
    },
    "packageChangeGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "consecutive_rounds", "retry_available"],
      "properties": {
        "code": {"enum": ["NO_PACKAGE_CHANGE", "UNKNOWN_GATE"]},
        "consecutive_rounds": {
          "oneOf": [
            {"type": "integer", "minimum": 1, "maximum": 10},
            {"type": "null"}
          ]
        },
        "retry_available": {"type": ["boolean", "null"]}
      }
    },
    "feedbackSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "feedback_repair_round",
        "result",
        "failure_count",
        "failure_refs"
      ],
      "properties": {
        "stage": {"enum": ["static", "direct_function", "unknown"]},
        "feedback_repair_round": {
          "oneOf": [
            {"type": "integer", "minimum": 0, "maximum": 10},
            {"type": "null"}
          ]
        },
        "result": {"enum": ["passed", "failed"]},
        "failure_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "failure_refs": {"$ref": "#/$defs/failureRefs"},
        "package_change_gate": {"$ref": "#/$defs/packageChangeGate"}
      }
    },
    "againstRoundFeedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_stage",
        "resolution_status",
        "unresolved",
        "matching_failure_count"
      ],
      "properties": {
        "same_stage": {"type": "boolean"},
        "resolution_status": {
          "enum": [
            "not_revalidated_different_stage",
            "resolved",
            "still_unresolved",
            "no_longer_reported"
          ]
        },
        "unresolved": {"type": ["boolean", "null"]},
        "matching_failure_count": {"type": "integer", "minimum": 0, "maximum": 64}
      }
    },
    "subsequentValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "feedback_repair_round",
        "result",
        "failure_count",
        "failure_refs",
        "against_round_feedback"
      ],
      "properties": {
        "stage": {"enum": ["static", "direct_function", "unknown"]},
        "feedback_repair_round": {
          "oneOf": [
            {"type": "integer", "minimum": 0, "maximum": 10},
            {"type": "null"}
          ]
        },
        "result": {"enum": ["passed", "failed"]},
        "failure_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "failure_refs": {"$ref": "#/$defs/failureRefs"},
        "package_change_gate": {"$ref": "#/$defs/packageChangeGate"},
        "against_round_feedback": {"$ref": "#/$defs/againstRoundFeedback"}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before_sha256",
        "inspection_status",
        "after_sha256",
        "changed"
      ],
      "properties": {
        "before_sha256": {"$ref": "#/$defs/sha256"},
        "inspection_status": {"enum": ["complete", "hash_failed"]},
        "after_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "changed": {"type": ["boolean", "null"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"inspection_status": {"const": "complete"}},
            "required": ["inspection_status"]
          },
          "then": {
            "properties": {
              "after_sha256": {"$ref": "#/$defs/sha256"},
              "changed": {"type": "boolean"}
            }
          },
          "else": {
            "properties": {
              "after_sha256": {"type": "null"},
              "changed": {"type": "null"}
            }
          }
        }
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "model_calls",
        "agent_turns",
        "provider_http_attempts",
        "provider_retries"
      ],
      "properties": {
        "status": {"enum": ["completed", "budget_exhausted", "failed"]},
        "model_calls": {"type": "integer", "minimum": 0},
        "agent_turns": {"type": "integer", "minimum": 0},
        "provider_http_attempts": {"type": "integer", "minimum": 0},
        "provider_retries": {"type": "integer", "minimum": 0}
      }
    },
    "processTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9_.:/-]{1,200}$"},
        "symbol": {"type": "string", "pattern": "^[A-Za-z0-9_.:/-]{1,200}$"},
        "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:/-]{1,200}$"},
        "capability_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:/-]{1,200}$"},
        "line_number": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "query": {
          "type": "object",
          "additionalProperties": false,
          "required": ["utf8_bytes", "sha256"],
          "properties": {
            "utf8_bytes": {"type": "integer", "minimum": 0},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "processCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "agent_turn",
        "tool",
        "operation",
        "outcome",
        "target",
        "arguments_sha256",
        "result_sha256"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 6},
        "agent_turn": {"type": "integer", "minimum": 1, "maximum": 6},
        "tool": {"type": "string", "pattern": "^[A-Za-z0-9_.:/-]{1,200}$"},
        "operation": {"enum": ["read", "write", "check", "other"]},
        "outcome": {"enum": ["ok", "timeout", "schema_rejected", "error"]},
        "target": {"$ref": "#/$defs/processTarget"},
        "arguments_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "result_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "processAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tool_call_count",
        "successful_write_calls",
        "protocol_error_count",
        "truncated_response_count",
        "provider_failure_count",
        "final_rejection_count",
        "last_action",
        "unfinished_read",
        "tool_calls",
        "privacy"
      ],
      "properties": {
        "schema_version": {"const": "robot_capability.repair_process_audit.v1"},
        "tool_call_count": {"type": "integer", "minimum": 0, "maximum": 6},
        "successful_write_calls": {"type": "integer", "minimum": 0, "maximum": 6},
        "protocol_error_count": {"type": "integer", "minimum": 0, "maximum": 6},
        "truncated_response_count": {"type": "integer", "minimum": 0, "maximum": 6},
        "provider_failure_count": {"type": "integer", "minimum": 0, "maximum": 6},
        "final_rejection_count": {"type": "integer", "minimum": 0, "maximum": 6},
        "last_action": {
          "enum": [
            "none",
            "provider_failure",
            "truncated_response",
            "protocol_error",
            "final_rejected",
            "tool",
            "final"
          ]
        },
        "unfinished_read": {
          "oneOf": [{"$ref": "#/$defs/processCall"}, {"type": "null"}]
        },
        "tool_calls": {
          "type": "array",
          "maxItems": 6,
          "items": {"$ref": "#/$defs/processCall"}
        },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_model_text_included",
            "raw_tool_arguments_included",
            "raw_tool_results_included",
            "raw_source_included"
          ],
          "properties": {
            "raw_model_text_included": {"const": false},
            "raw_tool_arguments_included": {"const": false},
            "raw_tool_results_included": {"const": false},
            "raw_source_included": {"const": false}
          }
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_refs",
        "resolution_status",
        "unresolved",
        "last_same_stage_validation_round"
      ],
      "properties": {
        "failure_refs": {"$ref": "#/$defs/failureRefs"},
        "resolution_status": {
          "enum": [
            "not_revalidated",
            "still_unresolved",
            "resolved_by_later_same_stage_pass",
            "no_longer_reported_by_same_stage"
          ]
        },
        "unresolved": {"type": "boolean"},
        "last_same_stage_validation_round": {
          "oneOf": [
            {"type": "integer", "minimum": 1, "maximum": 10},
            {"type": "null"}
          ]
        }
      }
    },
    "unresolvedFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_round",
        "failure_refs",
        "resolution_status",
        "unresolved",
        "last_same_stage_validation_round"
      ],
      "properties": {
        "origin_round": {"type": "integer", "minimum": 1, "maximum": 10},
        "failure_refs": {"$ref": "#/$defs/failureRefs"},
        "resolution_status": {"enum": ["not_revalidated", "still_unresolved"]},
        "unresolved": {"const": true},
        "last_same_stage_validation_round": {
          "oneOf": [
            {"type": "integer", "minimum": 1, "maximum": 10},
            {"type": "null"}
          ]
        }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "feedback",
        "package",
        "agent",
        "process",
        "subsequent_validation",
        "validation_observations",
        "failure_resolution",
        "secondary_errors"
      ],
      "properties": {
        "round": {"type": "integer", "minimum": 1, "maximum": 10},
        "feedback": {"$ref": "#/$defs/feedbackSummary"},
        "package": {"$ref": "#/$defs/package"},
        "agent": {"$ref": "#/$defs/agent"},
        "process": {"$ref": "#/$defs/processAudit"},
        "subsequent_validation": {
          "oneOf": [
            {"$ref": "#/$defs/subsequentValidation"},
            {"type": "null"}
          ]
        },
        "validation_observations": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/subsequentValidation"}
        },
        "failure_resolution": {
          "type": "array",
          "maxItems": 4,
          "items": {"$ref": "#/$defs/resolution"}
        },
        "secondary_errors": {
          "type": "array",
          "maxItems": 2,
          "items": {"$ref": "#/$defs/secondaryError"}
        }
      }
    },
    "secondaryError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "error_type"],
      "properties": {
        "operation": {
          "enum": [
            "abort_generated_file_writes",
            "hash_generated_package_after_repair"
          ]
        },
        "error_type": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,79}$"
        }
      }
    },
    "privacyContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_raw_messages",
        "contains_raw_tracebacks",
        "contains_raw_measurements_or_diagnostics",
        "failure_signature_fields",
        "allowed_diagnostic_fields",
        "identifier_pseudonymization"
      ],
      "properties": {
        "contains_raw_messages": {"const": false},
        "contains_raw_tracebacks": {"const": false},
        "contains_raw_measurements_or_diagnostics": {"const": false},
        "failure_signature_fields": {
          "const": [
            "code",
            "capability_ref",
            "case_ref",
            "diagnostic",
            "signature_sha256"
          ]
        },
        "allowed_diagnostic_fields": {
          "const": ["kind", "unresolved_symbol"]
        },
        "identifier_pseudonymization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "scope",
            "cross_round_linkable",
            "cross_run_linkable",
            "raw_identifiers_retained"
          ],
          "properties": {
            "algorithm": {"const": "salted_sha256_truncated_96bit"},
            "scope": {"const": "generation_agent_instance"},
            "cross_round_linkable": {"const": true},
            "cross_run_linkable": {"const": false},
            "raw_identifiers_retained": {"const": false}
          }
        }
      }
    }
  }
}
