{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot_capability.runtime_contract.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_id",
    "target_class",
    "contract_kind",
    "ownership",
    "runtime_view",
    "p0_configuration",
    "command_semantics",
    "generated_time_semantics",
    "error_semantics",
    "bridge_requirement"
  ],
  "properties": {
    "schema_version": {"const": "robot_capability.runtime_contract.v1"},
    "runtime_id": {"type": "string", "minLength": 1},
    "target_class": {"type": "string", "minLength": 1},
    "contract_kind": {"const": "injected_connected_robot_handle"},
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "injected_into_generated_functions",
        "required_state_on_entry",
        "generated_package_must_not",
        "generated_package_may"
      ],
      "properties": {
        "owner": {"const": "framework_runtime_manager"},
        "injected_into_generated_functions": {"const": true},
        "required_state_on_entry": {"const": "connected"},
        "generated_package_must_not": {"$ref": "#/$defs/nonemptyStringArray"},
        "generated_package_may": {"$ref": "#/$defs/nonemptyStringArray"}
      }
    },
    "runtime_view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_package_surface", "framework_only_inspection_surface"],
      "properties": {
        "generated_package_surface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["properties", "required_methods"],
          "properties": {
            "properties": {"type": "object", "maxProperties": 0},
            "required_methods": {
              "type": "object",
              "minProperties": 2,
              "maxProperties": 2,
              "additionalProperties": {"$ref": "#/$defs/methodContract"},
              "required": ["get_observation", "send_action"]
            }
          }
        },
        "framework_only_inspection_surface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["note", "properties"],
          "properties": {
            "note": {"type": "string", "minLength": 1},
            "properties": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "p0_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use_degrees",
        "cameras",
        "action_keys",
        "observation_keys",
        "units"
      ],
      "properties": {
        "use_degrees": {"type": "boolean"},
        "cameras": {"type": "object"},
        "action_keys": {"$ref": "#/$defs/nonemptyStringArray"},
        "observation_keys": {"$ref": "#/$defs/nonemptyStringArray"},
        "units": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "command_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_mode",
        "send_action_return_point",
        "physical_completion_signal",
        "polling_required_for_completion",
        "generated_capability_responsibilities",
        "sdk_does_not_provide"
      ],
      "properties": {
        "control_mode": {"const": "joint_position_target"},
        "send_action_return_point": {"type": "string", "minLength": 1},
        "physical_completion_signal": {"type": "string", "minLength": 1},
        "polling_required_for_completion": {"const": true},
        "generated_capability_responsibilities": {"$ref": "#/$defs/nonemptyStringArray"},
        "sdk_does_not_provide": {"$ref": "#/$defs/nonemptyStringArray"}
      }
    },
    "generated_time_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "import_statement",
        "allowed_calls",
        "minimum_sleep_s",
        "maximum_sleep_s",
        "mujoco",
        "hardware"
      ],
      "properties": {
        "import_statement": {"const": "import time"},
        "allowed_calls": {"const": ["time.sleep", "time.monotonic"]},
        "minimum_sleep_s": {"const": 0.0},
        "maximum_sleep_s": {"const": 60.0},
        "mujoco": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host_auto_step",
            "monotonic_source",
            "sleep_advances",
            "sleep_step_count",
            "per_tick_framework_callbacks"
          ],
          "properties": {
            "host_auto_step": {"const": false},
            "monotonic_source": {"const": "MjData.time"},
            "sleep_advances": {"const": "active_real_MjModel_MjData_pair"},
            "sleep_step_count": {
              "const": "ceil(seconds / model.opt.timestep)"
            },
            "per_tick_framework_callbacks": {
              "const": ["evidence_sampling", "video_capture_scheduling"]
            }
          }
        },
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module_binding", "monotonic_source", "sleep_effect"],
          "properties": {
            "module_binding": {"const": "python_standard_library_time"},
            "monotonic_source": {
              "const": "python_standard_library_time.monotonic"
            },
            "sleep_effect": {"const": "python_standard_library_time.sleep"}
          }
        }
      }
    },
    "error_semantics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "bridge_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "relationship", "must_match", "simulation_stepping_owner"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "relationship": {"type": "string", "minLength": 1},
        "must_match": {"$ref": "#/$defs/nonemptyStringArray"},
        "simulation_stepping_owner": {"const": "framework_runtime_manager"}
      }
    }
  },
  "$defs": {
    "nonemptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "methodContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameters", "returns"],
      "properties": {
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "type": {"type": "string", "minLength": 1}
            }
          }
        },
        "returns": {"type": "string", "minLength": 1}
      }
    }
  }
}
