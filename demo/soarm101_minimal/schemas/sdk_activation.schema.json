{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot_capability.sdk_activation.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "activation_scope",
    "live_gate_satisfied",
    "probe_status",
    "target",
    "runtime_id",
    "verified",
    "bindings"
  ],
  "properties": {
    "schema_version": {"const": "robot_capability.sdk_activation.v2"},
    "mode": {"enum": ["aws", "offline"]},
    "activation_scope": {
      "enum": ["live_aws_provider_gate", "offline_reference_only"]
    },
    "live_gate_satisfied": {"type": "boolean"},
    "probe_status": {"const": "pass"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "commit"],
      "properties": {
        "package": {"const": "lerobot"},
        "version": {"const": "0.6.0"},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "runtime_id": {"const": "lerobot_soarm101_0_6_0"},
    "verified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_import",
        "aliases",
        "required_methods",
        "action_keys",
        "observation_keys",
        "units",
        "send_action_nonblocking",
        "hardware_or_serial_opened"
      ],
      "properties": {
        "canonical_import": {
          "const": {
            "module": "lerobot.robots.so_follower",
            "symbols": ["SO101Follower", "SO101FollowerConfig"]
          }
        },
        "aliases": {
          "const": {
            "SO101Follower": "SOFollower",
            "SO101FollowerConfig": "SOFollowerRobotConfig"
          }
        },
        "required_methods": {
          "const": ["connect", "disconnect", "send_action", "get_observation"]
        },
        "action_keys": {"$ref": "#/$defs/sixFeatureKeys"},
        "observation_keys": {"$ref": "#/$defs/sixFeatureKeys"},
        "units": {"$ref": "#/$defs/p0Units"},
        "send_action_nonblocking": {"const": true},
        "hardware_or_serial_opened": {"const": false}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "api_surface", "runtime_contract", "api_probe"],
      "properties": {
        "manifest": {"$ref": "#/$defs/sourceBinding"},
        "api_surface": {"$ref": "#/$defs/sourceBinding"},
        "runtime_contract": {"$ref": "#/$defs/sourceBinding"},
        "api_probe": {"$ref": "#/$defs/sourceBinding"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "aws"}}, "required": ["mode"]},
      "then": {
        "properties": {
          "activation_scope": {"const": "live_aws_provider_gate"},
          "live_gate_satisfied": {"const": true}
        }
      },
      "else": {
        "properties": {
          "activation_scope": {"const": "offline_reference_only"},
          "live_gate_satisfied": {"const": false}
        }
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "sixFeatureKeys": {
      "const": [
        "shoulder_pan.pos",
        "shoulder_lift.pos",
        "elbow_flex.pos",
        "wrist_flex.pos",
        "wrist_roll.pos",
        "gripper.pos"
      ]
    },
    "p0Units": {
      "const": {
        "shoulder_pan.pos": "deg",
        "shoulder_lift.pos": "deg",
        "elbow_flex.pos": "deg",
        "wrist_flex.pos": "deg",
        "wrist_roll.pos": "deg",
        "gripper.pos": "normalized_0_100"
      }
    }
  }
}
