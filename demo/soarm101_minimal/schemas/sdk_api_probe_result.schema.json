{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot_capability.sdk_api_probe_result.v1",
  "oneOf": [
    {"$ref": "#/$defs/passResult"},
    {"$ref": "#/$defs/failResult"}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "nonemptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "distribution", "version", "commit"],
      "properties": {
        "package": {"type": "string", "minLength": 1},
        "distribution": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/hash"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "platform", "environment_policy"],
      "properties": {
        "python_version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "environment_policy": {"const": "demo_local_venv"}
      }
    },
    "passResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "target",
        "runtime_id",
        "environment",
        "canonical_import",
        "alias_targets",
        "canonical_aliases",
        "config_fields",
        "public_methods",
        "action_keys",
        "observation_keys",
        "signatures",
        "command_trace",
        "unit_modes",
        "fixture",
        "executed_on",
        "hardware_or_serial_opened"
      ],
      "properties": {
        "schema_version": {"const": "robot_capability.sdk_api_probe_result.v1"},
        "status": {"const": "pass"},
        "target": {"$ref": "#/$defs/target"},
        "runtime_id": {"type": "string", "minLength": 1},
        "environment": {"$ref": "#/$defs/environment"},
        "canonical_import": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module", "symbols"],
          "properties": {
            "module": {"type": "string", "minLength": 1},
            "symbols": {"$ref": "#/$defs/nonemptyUniqueStrings"}
          }
        },
        "alias_targets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "canonical_aliases": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"const": true}
        },
        "config_fields": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "public_methods": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "action_keys": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "observation_keys": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "signatures": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "command_trace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unclipped_read_count",
            "unclipped_write_count",
            "clipped_read_count",
            "clipped_write_count",
            "waits_for_arrival"
          ],
          "properties": {
            "unclipped_read_count": {"const": 0},
            "unclipped_write_count": {"const": 1},
            "clipped_read_count": {"const": 1},
            "clipped_write_count": {"const": 1},
            "waits_for_arrival": {"const": false}
          }
        },
        "unit_modes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "use_degrees_true_arm",
            "use_degrees_false_arm",
            "gripper_in_both_profiles"
          ],
          "properties": {
            "use_degrees_true_arm": {"const": "degrees"},
            "use_degrees_false_arm": {"const": "range_m100_100"},
            "gripper_in_both_profiles": {"const": "range_0_100"}
          }
        },
        "fixture": {"const": "probes/probe_api.py"},
        "executed_on": {"type": "string", "format": "date"},
        "hardware_or_serial_opened": {"const": false}
      }
    },
    "failResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "target",
        "runtime_id",
        "environment",
        "fixture",
        "executed_on",
        "hardware_or_serial_opened",
        "error_type",
        "error"
      ],
      "properties": {
        "schema_version": {"const": "robot_capability.sdk_api_probe_result.v1"},
        "status": {"const": "fail"},
        "target": {"$ref": "#/$defs/target"},
        "runtime_id": {"type": "string", "minLength": 1},
        "environment": {"$ref": "#/$defs/environment"},
        "fixture": {"const": "probes/probe_api.py"},
        "executed_on": {"type": "string", "format": "date"},
        "hardware_or_serial_opened": {"const": false},
        "error_type": {"type": "string", "minLength": 1},
        "error": {"type": "string", "minLength": 1}
      }
    }
  }
}
