{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot_capability.sealed_run_report.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "terminal_state",
    "terminal_reason",
    "mode",
    "sealed_at",
    "run_configuration",
    "input_hashes",
    "artifact_hashes",
    "evidence",
    "budgets",
    "model_accounting",
    "generation_agent",
    "repairs",
    "repair",
    "validation",
    "static_validation_passed",
    "direct_function_validation_passed",
    "validation_runtime",
    "demo",
    "video_recording",
    "evidence_boundary",
    "sdk_activation"
  ],
  "properties": {
    "schema_version": {"const": "robot_capability.sealed_run_report.v2"},
    "run_id": {"type": "string", "minLength": 1},
    "terminal_state": {"const": "SEALED"},
    "terminal_reason": {"const": "completed"},
    "mode": {"enum": ["offline", "aws"]},
    "sealed_at": {"type": "string", "format": "date-time"},
    "run_configuration": {"type": "object"},
    "input_hashes": {
      "type": "object",
      "minProperties": 14,
      "required": [
        "library_manifest:morphology",
        "library_manifest:sdk_runtime",
        "library_manifest:tasks",
        "library_manifest:experience",
        "source_tree",
        "sdk_activation:manifest",
        "sdk_activation:api_surface",
        "sdk_activation:runtime_contract",
        "sdk_activation:api_probe",
        "task_demo_batch",
        "task_private_oracles",
        "task_visible_catalog",
        "task_pilot_heldout_catalog"
      ],
      "additionalProperties": {"$ref": "#/$defs/hash"}
    },
    "artifact_hashes": {
      "type": "object",
      "required": [
        "stage1",
        "validation_suite",
        "generated_package",
        "combined_tool_catalog",
        "public_api",
        "package_manifest",
        "demo_freeze",
        "demo_report",
        "sdk_activation",
        "video_index"
      ],
      "additionalProperties": {"$ref": "#/$defs/hash"}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration",
        "run_manifest_preseal",
        "input_library_report",
        "private_execution_preflight",
        "stage1",
        "generated_package",
        "public_api",
        "validation_suite",
        "static_validation",
        "direct_validation",
        "tool_catalogs",
        "demo",
        "videos",
        "traces"
      ],
      "properties": {
        "configuration": {"type": "object"},
        "run_manifest_preseal": {"$ref": "#/$defs/fileEvidence"},
        "input_library_report": {"$ref": "#/$defs/fileEvidence"},
        "private_execution_preflight": {"$ref": "#/$defs/fileEvidence"},
        "stage1": {"$ref": "#/$defs/nonEmptyFiles"},
        "generated_package": {"type": "object"},
        "public_api": {"$ref": "#/$defs/fileEvidence"},
        "validation_suite": {"$ref": "#/$defs/nonEmptyFiles"},
        "static_validation": {"$ref": "#/$defs/nonEmptyFiles"},
        "direct_validation": {"$ref": "#/$defs/nonEmptyFiles"},
        "tool_catalogs": {"$ref": "#/$defs/nonEmptyFiles"},
        "demo": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/fileEvidence"}
        },
        "videos": {"$ref": "#/$defs/videoEvidenceList"},
        "traces": {
          "type": "array",
          "minItems": 8,
          "items": {"$ref": "#/$defs/fileEvidence"}
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_stage1",
        "generation_stage2_initial",
        "validation_suite",
        "demo",
        "repair"
      ],
      "properties": {
        "generation_stage1": {"$ref": "#/$defs/stage1Budget"},
        "generation_stage2_initial": {"$ref": "#/$defs/stage2Budget"},
        "validation_suite": {"$ref": "#/$defs/suiteBudget"},
        "demo": {"$ref": "#/$defs/demoBudget"},
        "repair": {"$ref": "#/$defs/repairBudget"}
      }
    },
    "model_accounting": {
      "type": "object",
      "required": ["public_identities", "roles", "aggregate", "generation_phases"],
      "properties": {
        "generation_phases": {"$ref": "#/$defs/generationPhases"}
      }
    },
    "generation_agent": {"type": "object"},
    "repairs": {"type": "array", "maxItems": 10},
    "repair": {"$ref": "#/$defs/repairSummary"},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "static_passed",
        "direct_function_passed",
        "suite_sha256",
        "public_api_sha256",
        "runtime"
      ],
      "properties": {
        "static_passed": {"const": true},
        "direct_function_passed": {"const": true},
        "suite_sha256": {"$ref": "#/$defs/hash"},
        "public_api_sha256": {"$ref": "#/$defs/hash"},
        "runtime": {"type": "string", "minLength": 1}
      }
    },
    "static_validation_passed": {"const": true},
    "direct_function_validation_passed": {"const": true},
    "validation_runtime": {"type": "string", "minLength": 1},
    "demo": {
      "type": "object",
      "additionalProperties": true,
      "required": ["summary", "tasks"],
      "properties": {
        "summary": {"$ref": "#/$defs/demoOutcomeSummary"},
        "tasks": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/demoOutcomeTask"}
        }
      }
    },
    "video_recording": {"$ref": "#/$defs/completeVideoIndex"},
    "evidence_boundary": {"type": "object"},
    "sdk_activation": {"$ref": "#/$defs/sdkActivation"}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "aws"}}, "required": ["mode"]},
      "then": {
        "properties": {
          "video_recording": {"$ref": "#/$defs/awsCompleteVideoIndex"},
          "evidence": {
            "properties": {
              "videos": {"$ref": "#/$defs/awsVideoEvidenceList"}
            }
          }
        }
      },
      "else": {
        "properties": {
          "video_recording": {"$ref": "#/$defs/offlineCompleteVideoIndex"},
          "evidence": {
            "properties": {
              "videos": {"$ref": "#/$defs/offlineVideoEvidenceList"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sdkActivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "evidence"],
      "properties": {
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "mode",
            "activation_scope",
            "live_gate_satisfied",
            "probe_status",
            "target",
            "runtime_id",
            "verified",
            "bindings"
          ],
          "properties": {
            "schema_version": {"const": "robot_capability.sdk_activation.v2"},
            "mode": {"enum": ["offline", "aws"]},
            "activation_scope": {"enum": ["offline_reference_only", "live_aws_provider_gate"]},
            "live_gate_satisfied": {"type": "boolean"},
            "probe_status": {"const": "pass"},
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": ["package", "version", "commit"],
              "properties": {
                "package": {"const": "lerobot"},
                "version": {"const": "0.6.0"},
                "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
              }
            },
            "runtime_id": {"const": "lerobot_soarm101_0_6_0"},
            "verified": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "canonical_import",
                "aliases",
                "required_methods",
                "action_keys",
                "observation_keys",
                "units",
                "send_action_nonblocking",
                "hardware_or_serial_opened"
              ],
              "properties": {
                "canonical_import": {
                  "const": {
                    "module": "lerobot.robots.so_follower",
                    "symbols": ["SO101Follower", "SO101FollowerConfig"]
                  }
                },
                "aliases": {
                  "const": {
                    "SO101Follower": "SOFollower",
                    "SO101FollowerConfig": "SOFollowerRobotConfig"
                  }
                },
                "required_methods": {
                  "const": ["connect", "disconnect", "send_action", "get_observation"]
                },
                "action_keys": {"$ref": "#/$defs/sdkSixFeatureKeys"},
                "observation_keys": {"$ref": "#/$defs/sdkSixFeatureKeys"},
                "units": {"$ref": "#/$defs/sdkP0Units"},
                "send_action_nonblocking": {"const": true},
                "hardware_or_serial_opened": {"const": false}
              }
            },
            "bindings": {
              "type": "object",
              "additionalProperties": false,
              "required": ["manifest", "api_surface", "runtime_contract", "api_probe"],
              "properties": {
                "manifest": {"$ref": "#/$defs/sdkSourceBinding"},
                "api_surface": {"$ref": "#/$defs/sdkSourceBinding"},
                "runtime_contract": {"$ref": "#/$defs/sdkSourceBinding"},
                "api_probe": {"$ref": "#/$defs/sdkSourceBinding"}
              }
            }
          },
          "allOf": [
            {
              "if": {"properties": {"mode": {"const": "aws"}}, "required": ["mode"]},
              "then": {
                "properties": {
                  "activation_scope": {"const": "live_aws_provider_gate"},
                  "live_gate_satisfied": {"const": true}
                }
              },
              "else": {
                "properties": {
                  "activation_scope": {"const": "offline_reference_only"},
                  "live_gate_satisfied": {"const": false}
                }
              }
            }
          ]
        },
        "evidence": {"$ref": "#/$defs/fileEvidence"}
      }
    },
    "sdkSourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "sdkSixFeatureKeys": {
      "const": [
        "shoulder_pan.pos",
        "shoulder_lift.pos",
        "elbow_flex.pos",
        "wrist_flex.pos",
        "wrist_roll.pos",
        "gripper.pos"
      ]
    },
    "sdkP0Units": {
      "const": {
        "shoulder_pan.pos": "deg",
        "shoulder_lift.pos": "deg",
        "elbow_flex.pos": "deg",
        "wrist_flex.pos": "deg",
        "wrist_roll.pos": "deg",
        "gripper.pos": "normalized_0_100"
      }
    },
    "demoPartitionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total", "success_rate"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer"},
        "success_rate": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    },
    "demoOutcomeSummary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["visible", "pilot-held-out", "overall"],
      "properties": {
        "visible": {
          "allOf": [
            {"$ref": "#/$defs/demoPartitionOutcome"},
            {"properties": {"passed": {"maximum": 3}, "total": {"const": 3}}}
          ]
        },
        "pilot-held-out": {
          "allOf": [
            {"$ref": "#/$defs/demoPartitionOutcome"},
            {"properties": {"passed": {"maximum": 3}, "total": {"const": 3}}}
          ]
        },
        "overall": {
          "allOf": [
            {"$ref": "#/$defs/demoPartitionOutcome"},
            {"properties": {"passed": {"maximum": 6}, "total": {"const": 6}}}
          ]
        }
      }
    },
    "demoOutcomeTask": {
      "type": "object",
      "required": ["partition", "task_id", "passed", "oracle"],
      "properties": {
        "partition": {"enum": ["visible", "pilot-held-out"]},
        "task_id": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "oracle": {
          "type": "object",
          "required": ["passed"],
          "properties": {"passed": {"type": "boolean"}}
        }
      }
    },
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "videoFileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "nonEmptyFiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fileEvidence"}
    },
    "videoEvidenceList": {
      "allOf": [
        {"$ref": "#/$defs/nonEmptyFiles"},
        {
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": {"path": {"const": "video_index.json"}}
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "awsVideoEvidenceList": {
      "allOf": [
        {"$ref": "#/$defs/videoEvidenceList"},
        {
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": {"path": {"type": "string", "pattern": "\\.mp4$"}}
          },
          "minContains": 7
        },
        {
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {"type": "string", "pattern": "\\.metadata\\.json$"}
            }
          },
          "minContains": 7
        }
      ]
    },
    "offlineVideoEvidenceList": {
      "allOf": [
        {"$ref": "#/$defs/videoEvidenceList"},
        {"maxItems": 1}
      ]
    },
    "stage1Budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "limit", "used", "remaining"],
      "properties": {
        "name": {"const": "generation_stage1"},
        "limit": {"const": 3},
        "used": {"type": "integer", "minimum": 0, "maximum": 3},
        "remaining": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "stage2Budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "limit", "used", "remaining"],
      "properties": {
        "name": {"const": "generation_stage2_initial"},
        "limit": {"const": 30},
        "used": {"type": "integer", "minimum": 0, "maximum": 30},
        "remaining": {"type": "integer", "minimum": 0, "maximum": 30}
      }
    },
    "suiteBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "limit", "used", "remaining"],
      "properties": {
        "name": {"const": "validation_suite"},
        "limit": {"const": 3},
        "used": {"type": "integer", "minimum": 0, "maximum": 3},
        "remaining": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "demoTaskBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "limit", "used", "remaining"],
      "properties": {
        "name": {"type": "string", "pattern": "^demo:.+"},
        "limit": {"const": 30},
        "used": {"type": "integer", "minimum": 0, "maximum": 30},
        "remaining": {"type": "integer", "minimum": 0, "maximum": 30}
      }
    },
    "demoBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit_per_task", "used_per_task", "per_task"],
      "properties": {
        "limit_per_task": {"const": 30},
        "used_per_task": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"type": "integer", "minimum": 0, "maximum": 30}
        },
        "per_task": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/demoTaskBudget"}
        }
      }
    },
    "repairRoundBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "limit", "used", "remaining"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^generation_repair_round_(0[1-9]|10)$"
        },
        "limit": {"const": 6},
        "used": {"type": "integer", "minimum": 0, "maximum": 6},
        "remaining": {"type": "integer", "minimum": 0, "maximum": 6}
      }
    },
    "phaseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "agent_turns",
        "provider_http_attempts",
        "provider_retries",
        "agent_turn_budget",
        "provider_attempt_budget_policy",
        "usage",
        "session_id",
        "episode_id"
      ],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "agent_turns": {"type": "integer", "minimum": 0},
        "provider_http_attempts": {"type": "integer", "minimum": 0},
        "provider_retries": {"type": "integer", "minimum": 0},
        "agent_turn_budget": {"type": "object"},
        "provider_attempt_budget_policy": {"type": "object"},
        "usage": {"type": "object"},
        "session_id": {"type": "string", "minLength": 1},
        "episode_id": {"type": "string", "minLength": 1}
      }
    },
    "stage1PhaseResult": {
      "allOf": [
        {"$ref": "#/$defs/phaseResult"},
        {"properties": {"agent_turn_budget": {"$ref": "#/$defs/stage1Budget"}}}
      ]
    },
    "stage2PhaseResult": {
      "allOf": [
        {"$ref": "#/$defs/phaseResult"},
        {"properties": {"agent_turn_budget": {"$ref": "#/$defs/stage2Budget"}}}
      ]
    },
    "repairResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "status",
        "agent_turns",
        "provider_http_attempts",
        "provider_retries",
        "client_kind",
        "scripted",
        "agent_turn_budget",
        "provider_attempt_budget_policy",
        "usage",
        "session_id",
        "episode_id"
      ],
      "properties": {
        "round": {"type": "integer", "minimum": 1, "maximum": 10},
        "status": {"type": "string", "minLength": 1},
        "agent_turns": {"type": "integer", "minimum": 0, "maximum": 6},
        "provider_http_attempts": {"type": "integer", "minimum": 0, "maximum": 6},
        "provider_retries": {"const": 0},
        "client_kind": {"type": "string", "minLength": 1},
        "scripted": {"type": "boolean"},
        "agent_turn_budget": {"$ref": "#/$defs/repairRoundBudget"},
        "provider_attempt_budget_policy": {"type": "object"},
        "usage": {"type": "object"},
        "session_id": {"type": "string", "minLength": 1},
        "episode_id": {"type": "string", "minLength": 1}
      }
    },
    "repairBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round_limit",
        "rounds_used",
        "rounds_remaining",
        "model_call_limit_per_round",
        "results"
      ],
      "properties": {
        "round_limit": {"const": 10},
        "rounds_used": {"type": "integer", "minimum": 0, "maximum": 10},
        "rounds_remaining": {"type": "integer", "minimum": 0, "maximum": 10},
        "model_call_limit_per_round": {"const": 6},
        "results": {
          "type": "array",
          "maxItems": 10,
          "items": {"$ref": "#/$defs/repairResult"}
        }
      }
    },
    "repairSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round_limit",
        "rounds_used",
        "rounds_remaining",
        "model_call_limit_per_round",
        "results",
        "history"
      ],
      "properties": {
        "round_limit": {"const": 10},
        "rounds_used": {"type": "integer", "minimum": 0, "maximum": 10},
        "rounds_remaining": {"type": "integer", "minimum": 0, "maximum": 10},
        "model_call_limit_per_round": {"const": 6},
        "results": {
          "type": "array",
          "maxItems": 10,
          "items": {"$ref": "#/$defs/repairResult"}
        },
        "history": {"type": "array", "maxItems": 10}
      }
    },
    "generationPhases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage1", "stage2_initial", "repair_rounds"],
      "properties": {
        "stage1": {"$ref": "#/$defs/stage1PhaseResult"},
        "stage2_initial": {"$ref": "#/$defs/stage2PhaseResult"},
        "repair_rounds": {
          "type": "array",
          "maxItems": 10,
          "items": {"$ref": "#/$defs/repairResult"}
        }
      }
    },
    "videoRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "id",
        "video",
        "metadata",
        "renderer_kind",
        "codec",
        "fps",
        "frames",
        "width",
        "height",
        "simulation_start_s",
        "simulation_end_s",
        "encoded_duration_s"
      ],
      "properties": {
        "phase": {"enum": ["validation", "demo"]},
        "id": {"type": "string", "minLength": 1},
        "video": {"$ref": "#/$defs/videoFileEvidence"},
        "metadata": {"$ref": "#/$defs/videoFileEvidence"},
        "renderer_kind": {"const": "mujoco.Renderer"},
        "codec": {"const": "mp4v"},
        "fps": {"const": 20},
        "frames": {"type": "integer", "minimum": 1},
        "width": {"const": 640},
        "height": {"const": 480},
        "simulation_start_s": {"type": "number"},
        "simulation_end_s": {"type": "number"},
        "encoded_duration_s": {"type": "number", "exclusiveMinimum": 0},
        "resolved_scene_binding": {"$ref": "#/$defs/resolvedSceneBinding"},
        "generation_environment_freeze_sha256": {"$ref": "#/$defs/hash"},
        "generation_environment_manifest_sha256": {"$ref": "#/$defs/hash"},
        "round": {"type": "integer", "minimum": 0, "maximum": 10},
        "case_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "suite_sha256": {"$ref": "#/$defs/hash"},
        "package_sha256": {"$ref": "#/$defs/hash"},
        "direct_report": {"$ref": "#/$defs/videoFileEvidence"},
        "demo_freeze": {"$ref": "#/$defs/videoFileEvidence"},
        "demo_report": {"$ref": "#/$defs/videoFileEvidence"}
      },
      "dependentRequired": {
        "generation_environment_freeze_sha256": [
          "generation_environment_manifest_sha256",
          "resolved_scene_binding"
        ],
        "generation_environment_manifest_sha256": [
          "generation_environment_freeze_sha256",
          "resolved_scene_binding"
        ]
      }
    },
    "resolvedSceneBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_sha256",
        "source_scene_request_sha256",
        "scene_catalog"
      ],
      "properties": {
        "binding_sha256": {"$ref": "#/$defs/hash"},
        "source_scene_request_sha256": {"$ref": "#/$defs/hash"},
        "scene_catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "catalog_id",
            "version",
            "source_sha256",
            "content_sha256"
          ],
          "properties": {
            "catalog_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "source_sha256": {"$ref": "#/$defs/hash"},
            "content_sha256": {"$ref": "#/$defs/hash"}
          }
        }
      }
    },
    "validationVideo": {
      "allOf": [
        {"$ref": "#/$defs/videoRecord"},
        {
          "required": [
            "round",
            "case_id",
            "suite_sha256",
            "package_sha256",
            "direct_report"
          ],
          "properties": {"phase": {"const": "validation"}},
          "not": {
            "anyOf": [
              {"required": ["task_id"]},
              {"required": ["demo_freeze"]},
              {"required": ["demo_report"]}
            ]
          }
        }
      ]
    },
    "demoVideo": {
      "allOf": [
        {"$ref": "#/$defs/videoRecord"},
        {
          "required": [
            "task_id",
            "package_sha256",
            "demo_freeze",
            "demo_report"
          ],
          "properties": {"phase": {"const": "demo"}},
          "not": {
            "anyOf": [
              {"required": ["round"]},
              {"required": ["case_id"]},
              {"required": ["suite_sha256"]},
              {"required": ["direct_report"]}
            ]
          }
        }
      ]
    },
    "completeVideoIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "required",
        "status",
        "renderer_kind",
        "codec",
        "fps",
        "width",
        "height",
        "validation",
        "demo",
        "offline_reason"
      ],
      "properties": {
        "schema_version": {"const": "robot_capability.mujoco_video_index.v1"},
        "required": {"type": "boolean"},
        "status": {"const": "complete"},
        "renderer_kind": {"const": "mujoco.Renderer"},
        "codec": {"const": "mp4v"},
        "fps": {"const": 20},
        "width": {"const": 640},
        "height": {"const": 480},
        "validation": {
          "type": "array",
          "items": {"$ref": "#/$defs/validationVideo"}
        },
        "demo": {
          "type": "array",
          "maxItems": 6,
          "items": {"$ref": "#/$defs/demoVideo"}
        },
        "offline_reason": {"type": ["string", "null"]}
      }
    },
    "awsCompleteVideoIndex": {
      "allOf": [
        {"$ref": "#/$defs/completeVideoIndex"},
        {
          "properties": {
            "required": {"const": true},
            "validation": {"minItems": 1},
            "demo": {"minItems": 6, "maxItems": 6},
            "offline_reason": {"type": "null"}
          }
        }
      ]
    },
    "offlineCompleteVideoIndex": {
      "allOf": [
        {"$ref": "#/$defs/completeVideoIndex"},
        {
          "properties": {
            "required": {"const": false},
            "validation": {"maxItems": 0},
            "demo": {"maxItems": 0},
            "offline_reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
