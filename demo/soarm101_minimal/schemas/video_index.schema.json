{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robot_capability.mujoco_video_index.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "required",
    "status",
    "renderer_kind",
    "codec",
    "fps",
    "width",
    "height",
    "validation",
    "demo",
    "offline_reason"
  ],
  "properties": {
    "schema_version": {"const": "robot_capability.mujoco_video_index.v1"},
    "required": {"type": "boolean"},
    "status": {"enum": ["partial", "complete"]},
    "renderer_kind": {"const": "mujoco.Renderer"},
    "codec": {"const": "mp4v"},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "width": {"type": "integer", "minimum": 160},
    "height": {"type": "integer", "minimum": 120},
    "validation": {"type": "array", "items": {"$ref": "#/$defs/validationVideo"}},
    "demo": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/demoVideo"}},
    "offline_reason": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "required": {"const": true},
          "status": {"const": "complete"}
        },
        "required": ["required", "status"]
      },
      "then": {
        "properties": {
          "validation": {"minItems": 1},
          "demo": {"minItems": 6, "maxItems": 6},
          "offline_reason": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"required": {"const": false}},
        "required": ["required"]
      },
      "then": {
        "properties": {
          "validation": {"maxItems": 0},
          "demo": {"maxItems": 0},
          "offline_reason": {"type": "string", "minLength": 1}
        }
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "id",
        "video",
        "metadata",
        "renderer_kind",
        "codec",
        "fps",
        "frames",
        "width",
        "height",
        "simulation_start_s",
        "simulation_end_s",
        "encoded_duration_s"
      ],
      "properties": {
        "phase": {"enum": ["validation", "demo"]},
        "id": {"type": "string", "minLength": 1},
        "video": {"$ref": "#/$defs/fileEvidence"},
        "metadata": {"$ref": "#/$defs/fileEvidence"},
        "renderer_kind": {"const": "mujoco.Renderer"},
        "codec": {"const": "mp4v"},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "frames": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 160},
        "height": {"type": "integer", "minimum": 120},
        "simulation_start_s": {"type": "number"},
        "simulation_end_s": {"type": "number"},
        "encoded_duration_s": {"type": "number", "exclusiveMinimum": 0},
        "resolved_scene_binding": {"$ref": "#/$defs/resolvedSceneBinding"},
        "generation_environment_freeze_sha256": {"$ref": "#/$defs/hash"},
        "generation_environment_manifest_sha256": {"$ref": "#/$defs/hash"},
        "round": {"type": "integer", "minimum": 0, "maximum": 10},
        "case_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "suite_sha256": {"$ref": "#/$defs/hash"},
        "package_sha256": {"$ref": "#/$defs/hash"},
        "direct_report": {"$ref": "#/$defs/fileEvidence"},
        "demo_freeze": {"$ref": "#/$defs/fileEvidence"},
        "demo_report": {"$ref": "#/$defs/fileEvidence"}
      },
      "dependentRequired": {
        "generation_environment_freeze_sha256": [
          "generation_environment_manifest_sha256",
          "resolved_scene_binding"
        ],
        "generation_environment_manifest_sha256": [
          "generation_environment_freeze_sha256",
          "resolved_scene_binding"
        ]
      }
    },
    "resolvedSceneBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_sha256",
        "source_scene_request_sha256",
        "scene_catalog"
      ],
      "properties": {
        "binding_sha256": {"$ref": "#/$defs/hash"},
        "source_scene_request_sha256": {"$ref": "#/$defs/hash"},
        "scene_catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "catalog_id",
            "version",
            "source_sha256",
            "content_sha256"
          ],
          "properties": {
            "catalog_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "source_sha256": {"$ref": "#/$defs/hash"},
            "content_sha256": {"$ref": "#/$defs/hash"}
          }
        }
      }
    },
    "validationVideo": {
      "allOf": [
        {"$ref": "#/$defs/video"},
        {
          "type": "object",
          "required": [
            "round",
            "case_id",
            "suite_sha256",
            "package_sha256",
            "direct_report"
          ],
          "properties": {"phase": {"const": "validation"}},
          "not": {
            "anyOf": [
              {"required": ["task_id"]},
              {"required": ["demo_freeze"]},
              {"required": ["demo_report"]}
            ]
          }
        }
      ]
    },
    "demoVideo": {
      "allOf": [
        {"$ref": "#/$defs/video"},
        {
          "type": "object",
          "required": [
            "task_id",
            "package_sha256",
            "demo_freeze",
            "demo_report"
          ],
          "properties": {"phase": {"const": "demo"}},
          "not": {
            "anyOf": [
              {"required": ["round"]},
              {"required": ["case_id"]},
              {"required": ["suite_sha256"]},
              {"required": ["direct_report"]}
            ]
          }
        }
      ]
    }
  }
}
