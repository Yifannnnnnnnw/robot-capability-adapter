{
  "artifact_type":"demo2_stage1_capability_policy","schema_version":"1.0.0","robot_configuration_id":"hello_robot_stretch_2","selection_semantics":{"allow_task_merge":true,"allow_task_subset":true,"rule":"Stage1 may merge opaque requirements that share an effect or disposition a subset; fixed collection order remains unchanged for execution."},
  "effect_contracts":{
    "drive_base_forward":{"kind":"action","description":"Drive the mobile base forward in its reset heading for a bounded distance and stop.","inputs":[{"name":"distance","type":"number","shape":"scalar","unit":"m","frame":"initial_base_yaw","required":true},{"name":"duration","type":"number","shape":"scalar","unit":"s","frame":"none","required":false}],"outputs":[],"required_action_affordances":["driver mobile-base motion"],"required_observation_affordances":["base pose observation","base velocity observation"]},
    "set_lift_height":{"kind":"action","description":"Move the Stretch lift by a supplied height change and hold it.","inputs":[{"name":"delta_height","type":"number","shape":"scalar","unit":"m","frame":"world","required":true},{"name":"duration","type":"number","shape":"scalar","unit":"s","frame":"none","required":false}],"outputs":[],"required_action_affordances":["driver lift motion"],"required_observation_affordances":["lift joint observation"]},
    "extend_arm":{"kind":"action","description":"Extend the coupled telescoping arm by a supplied amount and hold it.","inputs":[{"name":"extension","type":"number","shape":"scalar","unit":"m","frame":"arm_axis","required":true},{"name":"duration","type":"number","shape":"scalar","unit":"s","frame":"none","required":false}],"outputs":[],"required_action_affordances":["driver telescoping-arm motion"],"required_observation_affordances":["gripper-slider pose observation"]},
    "rotate_wrist":{"kind":"action","description":"Rotate the Stretch wrist yaw by a supplied angle and hold it.","inputs":[{"name":"delta_yaw","type":"number","shape":"scalar","unit":"rad","frame":"wrist","required":true},{"name":"duration","type":"number","shape":"scalar","unit":"s","frame":"none","required":false}],"outputs":[],"required_action_affordances":["driver wrist motion"],"required_observation_affordances":["wrist joint observation"]},
    "cycle_gripper":{"kind":"action","description":"Open and close the Stretch gripper once.","inputs":[{"name":"duration","type":"number","shape":"scalar","unit":"s","frame":"none","required":false}],"outputs":[],"required_action_affordances":["driver gripper motion"],"required_observation_affordances":["gripper joint observation"]}
  },
  "task_effect_allowlist":{"ST01":["drive_base_forward"],"ST02":["set_lift_height"],"ST03":["extend_arm"],"ST04":["rotate_wrist"],"ST05":["cycle_gripper"]}
