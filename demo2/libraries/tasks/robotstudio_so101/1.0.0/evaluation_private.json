    {
      "guard_id": "finite-required-state",
      "rule": "NaN, infinity, missing required measurement, or unavailable required observation fails the trial."
    },
    {
      "guard_id": "scene-entrypoint-bound",
      "rule": "The task must execute only in its declared source-backed MJCF scene."
    }
  ],
  "definitions": {
