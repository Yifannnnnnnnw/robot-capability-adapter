{
  "artifact_type": "demo2_stage1_capability_policy",
  "schema_version": "1.0.0",
  "robot_configuration_id": "robotstudio_so101",
  "effect_contracts": {
    "reach_above_object": {
      "kind": "action",
      "description": "Move the end effector to a supplied world-frame position above a task object and hold it.",
      "inputs": [
        {"name": "target_position", "type": "number", "shape": "vector:3", "unit": "m", "frame": "world", "required": true},
        {"name": "duration", "type": "number", "shape": "scalar", "unit": "s", "frame": "none", "required": false}
      ],
      "outputs": [],
      "required_action_affordances": ["driver Cartesian motion"],
      "required_observation_affordances": ["end-effector pose observation"]
    },
    "trace_cartesian_path": {
      "kind": "action",
      "description": "Visit a supplied ordered Cartesian waypoint path and finish at its final waypoint.",
      "inputs": [
        {"name": "waypoints", "type": "number", "shape": "matrix:Nx3", "unit": "m", "frame": "world", "required": true},
        {"name": "duration_per_segment", "type": "number", "shape": "scalar", "unit": "s", "frame": "none", "required": false}
      ],
      "outputs": [],
      "required_action_affordances": ["driver Cartesian motion"],
      "required_observation_affordances": ["end-effector pose observation"]
    },
    "cycle_gripper": {
      "kind": "action",
      "description": "Open and then close the robot gripper through its physical joint range.",
      "inputs": [
        {"name": "duration", "type": "number", "shape": "scalar", "unit": "s", "frame": "none", "required": false}
      ],
      "outputs": [],
      "required_action_affordances": ["driver gripper motion"],
      "required_observation_affordances": ["joint state observation"]
    },
    "establish_controlled_contact": {
      "kind": "action",
      "description": "Approach and make controlled end-effector contact at a supplied world-frame position.",
      "inputs": [
        {"name": "contact_position", "type": "number", "shape": "vector:3", "unit": "m", "frame": "world", "required": true},
        {"name": "duration", "type": "number", "shape": "scalar", "unit": "s", "frame": "none", "required": false}
      ],
      "outputs": [],
      "required_action_affordances": ["driver Cartesian motion"],
      "required_observation_affordances": ["end-effector pose observation", "contact observation"]
    },
    "move_cartesian_offset_and_return": {
      "kind": "action",
      "description": "Move by a supplied Cartesian offset and return to the starting end-effector position.",
      "inputs": [
        {"name": "offset", "type": "number", "shape": "vector:3", "unit": "m", "frame": "robot_base", "required": true},
        {"name": "duration", "type": "number", "shape": "scalar", "unit": "s", "frame": "none", "required": false}
      ],
      "outputs": [],
      "required_action_affordances": ["driver Cartesian motion"],
      "required_observation_affordances": ["end-effector pose observation"]
    }
  },
  "task_effect_allowlist": {
    "S01": ["reach_above_object"],
    "S02": ["trace_cartesian_path"],
    "S03": ["cycle_gripper"],
    "S04": ["establish_controlled_contact"],
    "S05": ["move_cartesian_offset_and_return"]
  }
}
