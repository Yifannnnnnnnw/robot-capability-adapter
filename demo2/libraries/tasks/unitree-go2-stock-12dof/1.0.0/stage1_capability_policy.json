{
  "artifact_type": "demo2_stage1_capability_policy",
  "schema_version": "1.0.0",
  "robot_configuration_id": "unitree-go2-stock-12dof",
  "effect_contracts": {
    "stand_up": {
      "kind": "action",
      "description": "Transition to a stable upright standing posture and hold it.",
      "inputs": [{"name": "duration", "type": "number", "shape": "scalar", "unit": "s", "frame": "none", "required": false}],
      "outputs": [],
      "required_action_affordances": ["driver posture motion"],
      "required_observation_affordances": ["body pose observation", "body velocity observation"]
    },
    "sit": {
      "kind": "action",
      "description": "Transition from standing to a supported sitting posture and hold it.",
      "inputs": [{"name": "duration", "type": "number", "shape": "scalar", "unit": "s", "frame": "none", "required": false}],
      "outputs": [],
      "required_action_affordances": ["driver posture motion"],
      "required_observation_affordances": ["body pose observation", "body velocity observation"]
    },
    "hold_stable": {
      "kind": "state_maintenance",
      "description": "Maintain the current upright stance at the current horizontal location for a bounded interval.",
      "inputs": [{"name": "duration", "type": "number", "shape": "scalar", "unit": "s", "frame": "none", "required": true}],
      "outputs": [],
      "required_action_affordances": ["driver posture motion"],
      "required_observation_affordances": ["body pose observation", "body velocity observation"]
    },
    "walk_forward": {
      "kind": "action",
      "description": "Move forward in the initial body-yaw frame for a bounded interval and finish upright and stopped.",
      "inputs": [
        {"name": "duration", "type": "number", "shape": "scalar", "unit": "s", "frame": "none", "required": true},
        {"name": "speed", "type": "number", "shape": "scalar", "unit": "m/s", "frame": "initial_body_yaw", "required": false}
      ],
      "outputs": [],
      "required_action_affordances": ["driver gait motion"],
      "required_observation_affordances": ["body pose observation", "body velocity observation"]
    },
    "set_body_height": {
      "kind": "action",
      "description": "Adjust to a supplied body height while remaining upright and near the current horizontal location.",
      "inputs": [
        {"name": "target_height", "type": "number", "shape": "scalar", "unit": "m", "frame": "world", "required": true},
        {"name": "duration", "type": "number", "shape": "scalar", "unit": "s", "frame": "none", "required": false}
      ],
      "outputs": [],
      "required_action_affordances": ["driver posture motion"],
      "required_observation_affordances": ["body pose observation", "body velocity observation"]
    }
  },
  "task_effect_allowlist": {
    "G01": ["stand_up"],
    "G02": ["sit"],
    "G03": ["hold_stable"],
    "G04": ["walk_forward"],
    "G05": ["set_body_height"]
  }
}
