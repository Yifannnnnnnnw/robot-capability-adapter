{
  "artifact_type": "demo2_stage1_capability_policy",
  "schema_version": "1.0.0",
  "robot_configuration_id": "universal_robots_ur5e",
  "effect_contracts": {
    "reach_target": {
      "kind": "action",
      "description": "Move the attachment site to a supplied world-frame Cartesian target and hold it.",
      "inputs": [
        {"name": "target_position", "type": "number", "shape": "vector:3", "unit": "m", "frame": "world", "required": true},
        {"name": "duration", "type": "number", "shape": "scalar", "unit": "s", "frame": "none", "required": false}
      ],
      "outputs": [],
      "required_action_affordances": ["driver Cartesian motion"],
      "required_observation_affordances": ["end-effector pose observation"]
    },
    "trace_cartesian_path": {
      "kind": "action",
      "description": "Visit a supplied ordered Cartesian waypoint path and return to its starting attachment-site position.",
      "inputs": [
        {"name": "waypoints", "type": "number", "shape": "matrix:Nx3", "unit": "m", "frame": "world", "required": true},
        {"name": "duration_per_segment", "type": "number", "shape": "scalar", "unit": "s", "frame": "none", "required": false}
      ],
      "outputs": [],
      "required_action_affordances": ["driver Cartesian motion"],
      "required_observation_affordances": ["end-effector pose observation"]
    },
    "move_cartesian_offset_and_return": {
      "kind": "action",
      "description": "Move by a supplied Cartesian offset and return to the starting attachment-site position.",
      "inputs": [
        {"name": "offset", "type": "number", "shape": "vector:3", "unit": "m", "frame": "robot_base", "required": true},
        {"name": "duration", "type": "number", "shape": "scalar", "unit": "s", "frame": "none", "required": false}
      ],
      "outputs": [],
      "required_action_affordances": ["driver Cartesian motion"],
      "required_observation_affordances": ["end-effector pose observation"]
    },
    "visit_cartesian_waypoints": {
      "kind": "action",
      "description": "Visit supplied world-frame Cartesian waypoints in order and finish at the final waypoint.",
      "inputs": [
        {"name": "waypoints", "type": "number", "shape": "matrix:Nx3", "unit": "m", "frame": "world", "required": true},
        {"name": "duration_per_segment", "type": "number", "shape": "scalar", "unit": "s", "frame": "none", "required": false}
      ],
      "outputs": [],
      "required_action_affordances": ["driver Cartesian motion"],
      "required_observation_affordances": ["end-effector pose observation"]
    },
    "reject_unreachable_and_return_home": {
      "kind": "action",
      "description": "Attempt one supplied Cartesian target, report an unreachable-target rejection when appropriate, and return to the starting home pose.",
      "inputs": [
        {"name": "target_position", "type": "number", "shape": "vector:3", "unit": "m", "frame": "world", "required": true},
        {"name": "duration", "type": "number", "shape": "scalar", "unit": "s", "frame": "none", "required": false},
        {"name": "home_duration", "type": "number", "shape": "scalar", "unit": "s", "frame": "none", "required": false}
      ],
      "outputs": [
        {"name": "outcome", "type": "string", "shape": "scalar", "unit": "unitless", "frame": "none", "required": true},
        {"name": "reason", "type": "string", "shape": "scalar", "unit": "unitless", "frame": "none", "required": true}
      ],
      "required_action_affordances": ["driver Cartesian motion"],
      "required_observation_affordances": ["end-effector pose observation"]
    }
  },
  "task_effect_allowlist": {
    "U01": ["reach_target"],
    "U02": ["trace_cartesian_path"],
    "U03": ["move_cartesian_offset_and_return"],
    "U04": ["visit_cartesian_waypoints"],
    "U05": ["reject_unreachable_and_return_home"]
  }
}
