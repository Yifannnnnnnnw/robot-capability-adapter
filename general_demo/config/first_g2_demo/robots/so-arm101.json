      "control_recipe": {
        "sdk_route": "Use the injected `_sdk.get_observation` and `_sdk.send_action` operations named by the public bundle; Framework owns session open and close.",
        "fresh_observation": "At the start of every loop iteration call `_sdk.get_observation()` and read the six ordered `.pos` fields from that returned observation.",
        "units": "The six arm values use the public degree unit: convert them to radians before FK and Jacobian work. Keep the gripper in its public normalized unit.",
        "tip_chain": "Use only chain entries whose public group is `arm` for the tip FK and Jacobian; explicitly exclude the `gripper` joint from the tip chain. The gripper remains an action field, not a tip-chain DoF.",
        "forward_kinematics": "Start from the public base frame and traverse the frozen public arm chain in order. For each joint use `T = T @ parent_to_joint @ Rz(q)`; after the arm chain, multiply the public `parent_to_reference` transform.",
        "jacobian": "Form an analytical or finite-difference numerical Jacobian from that same public arm chain and the current observed arm configuration; use `finite_difference_rad` for numerical differences.",
        "dls_step": "Compute `dq = gain * (J.T @ solve(J@J.T + damping**2 * I,error))` from the current public end-effector error, clip each joint step to `max_joint_step_rad`, then apply the public per-joint limits.",
        "tainted_action": "For every arm field, retain the raw fresh value as `current_obs` and construct the command exactly as `current_obs + (desired_degree - float(current_obs))`; do not first convert current_obs to NumPy or float, because that strips Sandbox lineage.",
        "ordered_send": "Send all six ordered fields through `_sdk.send_action`, preserving the public field order. For the gripper, retain the raw fresh `current_gripper_obs` and construct it the same way as `current_gripper_obs + (desired_gripper - float(current_gripper_obs))`, changing `desired_gripper` only when the public request requires.",
        "closed_loop": [
          "fresh observation",
          "state-dependent send",
          "allow Framework-owned execution time or physics to advance",
          "fresh observation",
          "state-dependent correction",
          "repeat from the newest observation"
        ],
        "convergence": "Use the fixed integer bound `for feedback_cycle in range(max_feedback_cycles)`. Do not return after the first send: complete at least `minimum_feedback_cycles` read-to-state-dependent-send-to-fresh-read correction cycles before allowing convergence exit; at the bound return the public non-converged result or error."
      },
