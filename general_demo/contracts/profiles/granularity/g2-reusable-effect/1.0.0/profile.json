{
  "profile_id": "g2-reusable-effect",
  "version": "1.0.0",
  "granularity": "G2",
  "exactly_one_profile_per_run": true,
  "capability_boundary": {
    "include": [
      "one reusable task-independent semantic effect",
      "one reusable state-maintenance contract",
      "one reusable observation contract",
      "one coherent composition of lower-level SDK primitives"
    ],
    "may_use": [
      "feedback",
      "inverse kinematics",
      "trajectory generation",
      "posture or gait logic",
      "multiple SDK calls"
    ],
    "exclude": [
      "complete downstream task solutions",
      "Demo-scene or object-instance constants",
      "private Validation or Demo criteria",
      "task-specific strategy",
      "mixed G1/G2/G3 layers"
    ]
  },
  "campaign_policy": {
    "allowed": ["G2"],
    "rejected": ["G1", "G3", "MULTI_PROFILE"]
  }
}
