<mujoco model="piper_pickbench">
  <!-- Piper arm + a small grasp-bench scene mirroring SO-101's setup.
       Uses weld-based grasping (toggled by the driver, matching the
       existing SO-101 mechanism). Located in piper/ so meshdir
       resolves correctly. -->

  <include file="piper.xml"/>

  <statistic center="0 0 0.25" extent="0.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane2" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane2" texture="groundplane2" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.72 0.62 0.45 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane2"/>

    <!-- Table at z=0.18 so objects sit within Piper's homed-EE workspace. -->
    <body name="table" pos="0.45 0 0">
      <geom name="tabletop" type="box" size="0.20 0.20 0.01" pos="0 0 0.18"
            material="table_mat" mass="100"/>
    </body>

    <body name="cube_red" pos="0.40 -0.08 0.215">
      <freejoint name="cube_red_free"/>
      <geom name="cube_red_geom" type="box" size="0.015 0.015 0.015"
            rgba="0.85 0.15 0.15 1" mass="0.020"
            friction="2.0 0.05 0.001" condim="4"/>
    </body>

    <body name="cube_green" pos="0.40 0.0 0.215">
      <freejoint name="cube_green_free"/>
      <geom name="cube_green_geom" type="box" size="0.015 0.015 0.015"
            rgba="0.15 0.75 0.15 1" mass="0.020"
            friction="2.0 0.05 0.001" condim="4"/>
    </body>

    <body name="cube_blue" pos="0.40 0.08 0.215">
      <freejoint name="cube_blue_free"/>
      <geom name="cube_blue_geom" type="box" size="0.015 0.015 0.015"
            rgba="0.15 0.40 0.85 1" mass="0.020"
            friction="2.0 0.05 0.001" condim="4"/>
    </body>
  </worldbody>

  <equality>
    <weld body1="link6" body2="cube_red"   active="false"/>
    <weld body1="link6" body2="cube_green" active="false"/>
    <weld body1="link6" body2="cube_blue"  active="false"/>
  </equality>
</mujoco>
