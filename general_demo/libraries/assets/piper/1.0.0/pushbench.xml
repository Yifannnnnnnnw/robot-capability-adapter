<mujoco model="piper_pushbench">
  <!-- Piper pushbench: same tabletop as pickbench but with push objects
       (T-shape, 3 cubes, obstacle). Piper has bigger workspace ~40cm
       so objects sit at x in [0.35, 0.50]. -->
  <include file="piper.xml"/>

  <statistic center="0 0 0.25" extent="0.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="gp_piper_push" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="gp_piper_push" texture="gp_piper_push" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat_piper_push" rgba="0.72 0.62 0.45 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor_piper_push" size="0 0 0.05" type="plane" material="gp_piper_push"/>

    <!-- Table -->
    <body name="table" pos="0.45 0 0">
      <geom name="tabletop_piper_push" type="box" size="0.20 0.20 0.01" pos="0 0 0.18"
            material="table_mat_piper_push" mass="100"/>
    </body>

    <!-- T-shape: composed of 2 box geoms -->
    <body name="tee" pos="0.35 -0.05 0.205">
      <freejoint name="tee_free"/>
      <inertial pos="0 -0.01 0" mass="0.040" diaginertia="3e-5 3e-5 5e-5"/>
      <geom name="tee_top" type="box" size="0.040 0.010 0.0075"
            pos="0 0.020 0" rgba="0.85 0.20 0.20 1"
            friction="1.5 0.005 0.0001" condim="6"/>
      <geom name="tee_stem" type="box" size="0.0075 0.020 0.0075"
            pos="0 -0.010 0" rgba="0.85 0.20 0.20 1"
            friction="1.5 0.005 0.0001" condim="6"/>
    </body>

    <body name="cube_red" pos="0.35 0.10 0.205">
      <freejoint name="cube_red_free"/>
      <inertial pos="0 0 0" mass="0.015" diaginertia="1e-5 1e-5 1e-5"/>
      <geom type="box" size="0.0075 0.0075 0.0075" rgba="0.95 0.15 0.15 1"
            friction="1.5 0.005 0.0001" condim="6"/>
    </body>

    <body name="cube_green" pos="0.45 0.12 0.205">
      <freejoint name="cube_green_free"/>
      <inertial pos="0 0 0" mass="0.015" diaginertia="1e-5 1e-5 1e-5"/>
      <geom type="box" size="0.0075 0.0075 0.0075" rgba="0.15 0.85 0.20 1"
            friction="1.5 0.005 0.0001" condim="6"/>
    </body>

    <body name="cube_blue" pos="0.40 0.15 0.205">
      <freejoint name="cube_blue_free"/>
      <inertial pos="0 0 0" mass="0.050" diaginertia="5e-5 5e-5 5e-5"/>
      <geom type="box" size="0.0075 0.0075 0.0075" rgba="0.15 0.30 0.95 1"
            friction="1.5 0.005 0.0001" condim="6"/>
    </body>

    <!-- Obstacle: tall cylinder at table level -->
    <body name="obs" pos="0.45 0.05 0.215">
      <inertial pos="0 0 0" mass="5.000" diaginertia="3e-3 3e-3 1.5e-3"/>
      <geom type="cylinder" size="0.012 0.025" rgba="0.45 0.45 0.45 1"
            friction="2 0.005 0.0001" condim="6"/>
    </body>
  </worldbody>
</mujoco>
