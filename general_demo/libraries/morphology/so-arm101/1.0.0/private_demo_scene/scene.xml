<!--
  Private fixed-Demo scene topology.  session.py composes this fragment around
  the caller-selected, pinned official SO-ARM101 MJCF in a temporary file.
  The fragment contains no controller or task policy.
-->
<mujoco model="so101-private-demo-scene">
  <asset>
    <material name="demo_table_material" rgba="0.52 0.34 0.18 1"/>
    <material name="demo_cube_material" rgba="0.82 0.12 0.10 1"/>
    <material name="demo_goal_material" rgba="0.10 0.80 0.25 0.35"/>
    <material name="demo_button_housing_material" rgba="0.16 0.18 0.22 1"/>
    <material name="demo_button_material" rgba="0.92 0.62 0.06 1"/>
    <material name="demo_face_material" rgba="0.12 0.35 0.95 0.65"/>
  </asset>

  <worldbody>
    <body name="demo_table" pos="0.35 0 0.01">
      <geom name="demo_table_surface" type="box" size="0.35 0.25 0.01"
        material="demo_table_material" contype="1" conaffinity="1"
        friction="1 0.01 0.001" condim="4"/>
    </body>

    <body name="demo_cube" pos="0.33 0.04 0.037">
      <freejoint name="demo_cube_free"/>
      <geom name="demo_cube_collision" type="box" size="0.017 0.017 0.017"
        material="demo_cube_material" mass="0.025" contype="1" conaffinity="1"
        friction="1 0.01 0.001" condim="6"/>
      <!-- A named, thin target-face geom makes intended face contact observable. -->
      <geom name="demo_cube_target_face" type="box" pos="0 -0.0175 0"
        size="0.0165 0.0005 0.0165" material="demo_face_material"
        contype="1" conaffinity="1" friction="1 0.01 0.001" condim="6"/>
      <site name="demo_cube_center" pos="0 0 0" size="0.002" rgba="0.95 0.15 0.10 0.85" group="4"/>
      <site name="demo_target_face_marker" pos="0 -0.0182 0" size="0.004" rgba="0.12 0.35 0.95 0.80" group="4"/>
    </body>

    <geom name="demo_goal_region" type="cylinder" pos="0.43 0.04 0.0205"
      size="0.025 0.0005" material="demo_goal_material"
      contype="0" conaffinity="0" group="4"/>
    <site name="demo_goal_center" pos="0.43 0.04 0.021" size="0.003"
      rgba="0.10 0.80 0.25 0.85" group="4"/>

    <!-- The plunger is a passive slide joint.  Contact/activation is read from
         MuJoCo truth; no actuator or task-specific behavior is introduced. -->
    <body name="demo_button_base" pos="0.43 -0.10 0.025">
      <geom name="demo_button_housing" type="box" pos="0 0 0.018"
        size="0.045 0.045 0.018" material="demo_button_housing_material"
        contype="1" conaffinity="1" friction="1 0.01 0.001" condim="4"/>
      <body name="demo_button_large" pos="0 0 0.040">
        <joint name="demo_button_slide" type="slide" axis="0 0 -1"
          range="0 0.020" springref="0" stiffness="100" damping="2.0"/>
        <geom name="demo_button_plunger" type="cylinder" pos="0 0 0.010"
          size="0.028 0.010" material="demo_button_material" mass="0.015"
          contype="1" conaffinity="1" friction="1 0.01 0.001" condim="4"/>
        <site name="demo_button_activation_site" pos="0 0 0.020" size="0.004"
          rgba="0.95 0.70 0.08 0.90" group="4"/>
      </body>
    </body>

    <!-- Framework Evaluation Video camera; it is not an admitted robot sensor. -->
    <camera name="evaluation_external_camera" mode="targetbody" target="base"
      pos="0.72 -0.72 0.58" fovy="48"/>
  </worldbody>

  <sensor>
    <touch name="demo_button_touch" site="demo_button_activation_site"/>
    <jointpos name="demo_button_displacement" joint="demo_button_slide"/>
    <jointvel name="demo_button_velocity" joint="demo_button_slide"/>
  </sensor>
</mujoco>
